7.880Z\",\"updatedAt\":\"2024-09-09T16:20:17.138Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":15,\"revision\":3,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"linklist\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"Footer - USA - Social Linklist\",\"heading\":\"Social\",\"links\":[]}}],\"newsletterHeading\":\"In Cran We Trust\",\"newsletterText\":\"Wave your cran flag high. Join now and get access to exclusive offers, the latest news from the bog, and new product sneak peeks.\",\"newsletterTermsConditionsText\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim\\n\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"legalHeading\":\"©2024 Ocean Spray\",\"destini\":\"oceanspray\",\"bazaarVoice\":\"oceanspray\",\"curalate\":\"oceanspray-g0frjz\",\"bazaarVoiceSiteId\":\"main_site\",\"engineId\":\"j-As7u-eo3_Qc-Xhor-A\",\"gtm\":\"GTM-M7VQVSDN\",\"gtag\":\"G-CSHX9SKFN4\",\"gtmTest\":\"GTM-N8S9WFFH\",\"gtagTest\":\"G-LPKMNCGB2P\",\"cookieDialog\":{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"48JWsEo6LLhMqeq8gvOykb\",\"type\":\"Entry\",\"createdAt\":\"2024-02-27T20:37:40.615Z\",\"updatedAt\":\"2025-01-14T21:22:54.156Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":213,\"revision\":14,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"moduleDialogCookies\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"[Default] Cookie Modal\",\"title\":\"Cookie Information\",\"heading\":\"We use cookies\",\"bodyText\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"We use cookies to collect information about you. We use this information:\u2028\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"},{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"to give you a better experience of our website (functional)\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"list-item\"},{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"to count the pages you visit (statistics)\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"list-item\"},{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"to serve you relevant promotions (marketing)\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"list-item\"}],\"nodeType\":\"ordered-list\"},{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Click “OK” to give us your consent to use cookies for all these purposes. You can also use the checkboxes to consent to specific purposes. Select purposes and “Save settings”.Withdraw or change your consent at any time by clicking the icon in the bottom left corner of the screen. Change your settings. Read more about how we use cookies and other technologies to collect personal data:\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"policyLinks\":[],\"declineLabel\":\"Decline All\",\"acceptLabel\":\"Accept\",\"detailsToggleLabelShow\":\"Show Details\",\"detailsToggleLabelHide\":\"Hide Details\",\"cookiesHeadingNecessary\":\"Strictly Necessary\",\"cookiesHeadingFunctional\":\"Functional\",\"cookiesHeadingStatistical\":\"Statistical\",\"cookiesHeadingMarketing\":\"Marketing\",\"cookiesHeadingUnclassified\":\"Unclassified\",\"cookiesTextNecessary\":\"Strictly necessary cookies help make a website navigable by activating basic functions such as page navigation and access to secure website areas. Without these cookies, the website would not be able to work properly.\",\"cookiesTextFunctional\":\"Functional cookies make it possible to save information that changes the way the website appears or acts. For instance your preferred language or region.\",\"cookiesTextStatistical\":\"Statistical cookies help the website owner understand how visitors interact with the website by collecting and reporting information.\",\"cookiesTextMarketing\":\"Marketing cookies are used to track visitors across websites. The intention is to display ads that are relevant and interesting to the individual user and thus more valuable for publishers and third-party advertisers.\",\"cookiesTextUnclassified\":\"We are in the process of classifying unclassified cookies together with the providers of the individual cookies.\"}},\"dictionary\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"28p2JqzwPvXsM3MBaWcpVI\",\"type\":\"Entry\",\"createdAt\":\"2023-12-06T22:07:14.426Z\",\"updatedAt\":\"2024-05-14T22:20:14.825Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":26,\"revision\":6,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"dictionary\"}},\"locale\":\"en-US\"},\"fields\":{\"name\":\"Global Dictionary\",\"microcopy\":[{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"7DNOGgYOLAQ6PuYnuQywiY\",\"type\":\"Entry\",\"createdAt\":\"2024-03-18T14:20:45.518Z\",\"updatedAt\":\"2024-07-28T15:30:38.124Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":126,\"revision\":3,\"contentType\":{\"sys\":{\"typ