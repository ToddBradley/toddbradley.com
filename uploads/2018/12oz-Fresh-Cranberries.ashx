EAC-9D5E-C66589469F65\",\"sitecoreId\":\"{140DFDD5-681D-4AD5-BFD1-6FE7D673564D}\",\"associatedRecipes\":[],\"disclaimer\":\"No artificial colors, flavors or preservatives, Gluten Free, Peanut Free, Made from Real Fruit\"}},{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"2y2MMtBIg80LhoqTcYr29A\",\"type\":\"Entry\",\"createdAt\":\"2024-02-13T13:24:23.766Z\",\"updatedAt\":\"2025-05-07T14:44:48.546Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":107,\"revision\":16,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"product\"}},\"locale\":\"en-US\"},\"fields\":{\"title\":\"Craisins® Dried Cranberries Cherry Juice Infused\",\"slug\":\"craisins-dried-cranberries-cherry-juice-infused-6-oz\",\"hubSpotLabel\":\"Craisins® Dried Cranberries Cherry Juice Infused\",\"description\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Big, bold, and bursting with cherry goodness. Ocean Spray® Cherry Flavored Craisins® Dried Cranberries combine the tart punch of dried cranberries with juicy cherry flavor for a snack that’s sweet, tangy, and totally crave-worthy. \",\"nodeType\":\"text\"},{\"data\":{},\"marks\":[],\"value\":\"Plus, 1 serving of Craisins® Dried Cranberries Cherry Juice Infused meets 25% of your daily recommended fruit needs. †Each ¼ cup serving Craisins® Dried Cranberries provides ½ cup of fruit.  The USDA My Plate recommends a daily intake of 2 cups of fruit for a 2,000 calorie diet. \",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"frontImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"9z7BGChoW0OXnHwQBSFTk\",\"type\":\"Asset\",\"