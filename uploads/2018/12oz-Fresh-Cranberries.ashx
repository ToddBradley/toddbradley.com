data\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"10ojtDytVETiYWsmJLgKnY\",\"type\":\"Entry\",\"createdAt\":\"2024-02-13T13:23:52.809Z\",\"updatedAt\":\"2025-01-16T09:46:18.884Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":74,\"revision\":17,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"product\"}},\"locale\":\"en-US\"},\"fields\":{\"title\":\"Cosmo Cocktail Mixer\",\"slug\":\"cosmopolitan-cocktail-mixer-32-oz\",\"hubSpotLabel\":\"Cosmo Cocktail Mixer\",\"description\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"A perfectly balanced mix of cranberry and lime flavors ready in seconds. Just add vodka to Ocean Spray® Cosmopolitan Cocktail Mixer for a restaurant quality cosmo at home. Made from real cranberry and lime fruit juice and less sugar than the leading mixer, this cosmopolitan mix strikes the right balance between sweet and tart for beverages with big city taste and at-home ease. Make a splash and impress guests with this cosmopolitan drink mixer; perfect for creating effortlessly excellent cocktails for big and small gatherings and special events. Whether you're stirring in your favorite vodka or trying something new, this drink mix makes a bright, refreshing beverage every time. Ocean Spray® also offers other delicious drink mixers for your favorite cocktails in seconds. We believe in uncommonly bold mashups.\",\"marks\":[],\"data\":{}}]}]},\"frontImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"69CIX3z4uytR95Kd15EHWu\",\"type\":\"Asset\",\"createdAt\":\"2024-03-12T19:14:22.548Z\",\"updatedAt\":\"2024-03-12T19:14:22.548Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":2,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"Cosmopolitan Cocktail Mixer\",\"description\":\"Cosmopolitan Cocktail Mixer front image.\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b3/69CIX3z4uytR95Kd15EHWu/6cfb5a849acfd371314f0b3c47ad4528/Cosmopolitan_Cocktail_Mixer.png\",\"details\":{\"size\":360945,\"image\":{\"width\":1000,\"height\":1400}},\"fileName\":\"Cosmopolitan Cocktail Mixer.png\",\"contentType\":\"image/png\"}}},\"gtin\":\"00031200022691\",\"size\":\"32 oz\",\"nutritionalInfoImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"6idVTbDBAkMootL2xNMKtD\",\"type\":\"Asset\",\"createdAt\":\"2024-09-10T19:02:39.202Z\",\"updatedAt\":\"2024-09-10T19:02:39.202Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":5,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"32oz OS Cosmo Mixer NFP(00002 0000016702)(5152) 1 Ingredients\",\"description\":\"Image for 32oz OS Cosmo Mixer NFP(00002 0000016702)(5152) 1\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b3/6idVTbDBAkMootL2xNMKtD/cac082bee641a01a05e00d6645e04652/Cosmopolitan_Cocktail_Mixer_NutFacts.jpg\",\"details\":{\"size\":160365,\"image\":{\"width\":366,\"height\":785}},\"fileName\":\"Cosmopolitan_Cocktail_Mixer_NutFacts.jpg\",\"contentType\":\"image/jpeg\"}}},\"nutritionalFacts\":[{\"id\":\"f6c9c4a9-54b6-433e-9e8b-64f002478d8f\",\"key\":\"Made with Real Fruit Juice\",\"value\":\"\"},{\"id\":\"8e333e0c-54c7-469e-a0f5-ec72e9ceea15\",\"key\":\"Less sugar than the leading mixer\",\"value\":\"This product (12g sugar per 3 FL OZ) has 35% less sugar than the leading brand cocktail mixer (19g sugar per 3 FL OZ).\"}],\"countries\":[{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"4YhS9Pyt2s9lYDTnbwU7cg\",\"type\":\"Entry\",\"createdAt\":\"2023-12-06T22:07:30.385Z\",\"updatedAt\":\"2024-10-24T10:00:24.527Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":105,\"revision\":39,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"country\"}},\"locale\":\"en-US\"},\"fields\":{\"name\":\"United States\",\"tld\":\"com\",\"countryCode\":\"US\",\"languages\":[],\"headerMenus\":[],\"footerMenus\":[],\"newsletterHeading\":\"In Cran We Trust\",\"newsletterText\":\"Wave your cran flag high. Join now and get access to exclusive offers, the latest news from the bog, and new product sneak peeks.\",\"newsletterTermsConditionsText\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim\\n\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"legalHeading\":\"©2024 Ocean Spray\",\"destini\":\"oceanspray\",\"mikmak\":\"670032a57a1d7c0f07baae48\",\"bazaarVoice\":\"oceanspray\",\"curalate\":\"oceanspray-g0frjz\",\"bazaarVoiceSiteId\":\"main_site\",\"engineId\":\"j-As7u-eo3_Qc-Xhor-A\",\"gtm\":\"GTM-M7VQVSDN\",\"gtag\":\"G-CSHX9SKFN4\",\"gtmTest\":\"GTM-N8S9WFFH\",\"gtagTest\":\"G-LPKMNCGB2P\"}}],\"category\":\"[Circular]\",\"backgroundColor\":\"Bright Red\",\"destiniAssociationId\":\"cosmo_cocktail_mixer\",\"bvProductId\":\"768B3D63-305F-45CD-9A39-14DA4C76BF3B\",\"curalateProductId\":\"768B3D63-305F-45CD-9A39-14DA4C76BF3B-32 oz\",\"typeFilters\":[],\"benefitFilters\":[],\"dietaryFilters\":[],\"flavorFilters\":[],\"metaTitle\":\"Ocean Spray® Cosmopolitan Cocktail Mixer - Easy Mixing Ingredients\",\"metaDescription\":\"Unleash the mixologist in you with Ocean Spray's premium Cosmopolitan cocktail mixer. Easy cocktail mixing becomes your new forte with this top-notch juice drink.\",\"metaKeywords\":\"Juices and Drinks, Cosmopolitan Cocktail Mixer\",\"ogTitle\":\"\",\"upc\":\"768B3D63-305F-45CD-9A39-14DA4C76BF3B\",\"sitecoreId\":\"{768B3D63-305F-45CD-9A39-14DA4C76BF3B}\",\"associatedRecipes\":[],\"disclaimer\":\"Made with real fruit juice\\r\\n\\r\\nLess sugar than the leading mixer\\r\\n\\r\\n This product (12g sugar per 3 FL OZ) has 35% less sugar than the leading brand cocktail mixer (19g sugar per 3 FL OZ). \"}},{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"2lIK2MpjdFSOCFsWsJqFpO\",\"type\":\"Entry\",\"createdAt\":\"2024-02-13T13:24:06.513Z\",\"updatedAt\":\"2025-01-16T09:44:19.480Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":59,\"revision\":15,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"product\"}},\"locale\":\"en-US\"},\"fields\":{\"title\":\"Strawberry Margarita Cocktail Mixer\",\"slug\":\"strawberry-margarita-cocktail-mixer-32-oz\",\"hubSpotLabel\":\"Strawberry Margarita Cocktail Mixer\",\"description\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"A perfectly balanced mix of strawberry and lime flavors ready in seconds. Just add tequila to Ocean Spray® Strawberry Margarita Cocktail Mixer for a restaurant quality margarita at home. Made from real strawberry and lime fruit juice and less sugar than the leading mixer, this strawberry margarita mix strikes the right balance between sweet and tangy for beverages with vacation taste and at-home ease. Make a splash and impress guests with this margarita drink mixer; perfect for creating effortlessly excellent cocktails for big and small gatherings and special events. Whether you're stirring in your favorite tequila or trying something new, this margarita mixer makes a bold, refreshing beverage every time. Ocean Spray® also offers other delicious drink mixers for your favorite cocktails in seconds. We believe in uncommonly bold mashups.\",\"marks\":[],\"data\":{}}]}]},\"frontImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"2xBtkCbX9QLiLhM8InfsgQ\",\"type\":\"Asset\",\"createdAt\":\"2024-03-12T19:19:34.484Z\",\"updatedAt\":\"2024-03-12T19:19:34.484Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":2,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"Strawberry Margarita Cocktail Mixer\",\"description\":\"Strawberry Margarita Cocktail Mixer front image.\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b3/2xBtkCbX9QLiLhM8InfsgQ/c6583f70a7d85a60592ea94f7a13fc6e/Strawberry_Margarita_Cocktail_Mixer.png\",\"details\":{\"size\":378876,\"image\":{\"width\":1000,\"height\":1400}},\"fileName\":\"Strawberry Margarita Cocktail Mixer.png\",\"contentType\":\"image/png\"}}},\"gtin\":\"00031200022684\",\"size\":\"32 oz\",\"nutritionalInfoImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"67WgRB1lEGvMwegRlRwWuS\",\"type\":\"Asset\",\"createdAt\":\"2024-09-10T18:28:03.048Z\",\"updatedAt\":\"2024-09-10T18:28:03.048Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":5,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"32oz OS Strawberry Margarita Mixer NFP(00002 0000016711)(5153) 1 Ingredients\",\"description\":\"Image for 32oz OS Strawberry Margarita Mixer NFP(00002 0000016711)(5153) 1\",\"file\":{\"url\":\"/c