le\":\"Juices \u0026 Juice Drinks\",\"themeColor\":\"Red\",\"backgroundText\":\"Wild \u0026 Fresh\",\"shortDescription\":\"The category landing page for juices.\",\"featuredProducts\":[{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"1lDNMsvqn9lQOF2YxsH0R2\",\"type\":\"Entry\",\"createdAt\":\"2024-02-13T13:05:59.956Z\",\"updatedAt\":\"2025-10-22T15:33:09.383Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":365,\"revision\":23,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"product\"}},\"locale\":\"en-US\"},\"fields\":{\"title\":\"The Original Cranberry Juice Cocktail\",\"metaTitle\":\"Nutritious Ocean Spray® Original Cranberry Juice Cocktail\",\"metaDescription\":\"Get ready for our Ocean Spray® Cranberry Juice Cocktail, a love letter to nutritious juices. This isn't your average fruit juice product—it's a healthy dose of flavor.\",\"metaKeywords\":\"cranberry juice, cranberry juice blends\",\"backgroundColor\":\"Bright Red\",\"countries\":[{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"4YhS9Pyt2s9lYDTnbwU7cg\",\"type\":\"Entry\",\"createdAt\":\"2023-12-06T22:07:30.385Z\",\"updatedAt\":\"2024-10-24T10:00:24.527Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":105,\"revision\":39,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"country\"}},\"locale\":\"en-US\"},\"fields\":{\"name\":\"United States\",\"tld\":\"com\",\"countryCode\":\"US\",\"languages\":[],\"headerMenus\":[],\"footerMenus\":[],\"newsletterHeading\":\"In Cran We Trust\",\"newsletterText\":\"Wave your cran flag high. Join now and get access to exclusive offers, the latest news from the bog, and new product sneak peeks.\",\"newsletterTermsConditionsText\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim\\n\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"legalHeading\":\"©2024 Ocean Spray\",\"destini\":\"oceanspray\",\"mikmak\":\"670032a57a1d7c0f07baae48\",\"bazaarVoice\":\"oceanspray\",\"curalate\":\"oceanspray-g0frjz\",\"bazaarVoiceSiteId\":\"main_site\",\"engineId\":\"j-As7u-eo3_Qc-Xhor-A\",\"gtm\":\"GTM-M7VQVSDN\",\"gtag\":\"G-CSHX9SKFN4\",\"gtmTest\":\"GTM-N8S9WFFH\",\"gtagTest\":\"G-LPKMNCGB2P\"}}],\"gtin\":\"00031200200075\",\"slug\":\"cranberry-juice-cocktail-64-oz\",\"frontImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"7eJjV4XFIn6vua5J7prv5y\",\"type\":\"Asset\",\"createdAt\":\"2024-04-11T15:20:29.278Z\",\"updatedAt\":\"2024-04-11T15:20:29.278Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":2,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"64oz OS Cranberry front v2\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b3/7eJjV4XFIn6vua5J7prv5y/6e26af9458c2e0024bc94f40cbb56e96/64oz_OS_Cranberry_front_v2.png\",\"details\":{\"size\":192536,\"image\":{\"width\":500,\"height\":500}},\"fileName\":\"64oz_OS_Cranberry_front_v2.png\",\"contentType\":\"image/png\"}}},\"description\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Crisp. Experience the insane deliciousness of Ocean Spray® Cranberry Juice Cocktail. The trailblazing juice drink made with bold cranberry fruit juice concentrate. This fruit juice beverage packs 100% of your recommended daily value of vitamin C in a single serving. No high fructose corn syrup. This beverage has only the good stuff. Use this cranberry juice drink as a cocktail mixer for radically refreshing drinks. Serve it over ice with a splash of vodka for a tangy cranberry cocktail. Or change up dinner with some cranberry drunken chicken or cranberry cocktail meatballs. Original Cranberry Juice Cocktail makes a delicious, unique addition to blended beverages and ice pops, too. Get creative. Go bog-wild. All this made possible by the 700+ cranberry family farmers that make up our co-op. Our owners. Our heartbeat. Our inspiration. Ocean Spray believes in the power of the mighty cranberry; Born Tart. Raised Bold.™\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"size\":\"64 oz\",\"nutritionalInfoImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"12cCVmDiPdx071GcPQV4SZ\",\"type\":\"Asset\",\"createdAt\":\"2024-09-06T18:35:17.627Z\",\"updatedAt\":\"2025-08-18T12:00:36.999Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":12,\"revision\":2,\"locale\":\"en-US\"},\"fields\":{\"title\":\"64oz OS Cranberry NFP(00002 0000018595)(5328) 1 Ingredients\",\"description\":\"Image for 64oz OS Cranberry NFP(00002 0000018595)(5328) 1 Ingredients\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b3/12cCVmDiPdx071GcPQV4SZ/e9284b14ea7ce51813ec19c231983432/64oz_OS_Cranberry_Juice_Cocktail_NutFacts.png\",\"details\":{\"size\":538651,\"image\":{\"width\":3000,\"height\":3000}},\"fileName\":\"64oz_OS_Cranberry_Juice_Cocktail_NutFacts.png\",\"contentType\":\"image/png\"}}},\"nutritionalFacts\":[{\"id\":\"8c9d2b47-61a1-4391-9dfd-c411938122eb\",\"key\":\"No High Fructose Corn Syrup\",\"value\":\"\"},{\"id\":\"b6f07300-eec9-4069-8bff-dccf0a6a5fa6\",\"key\":\"100% Vitamin C\",\"value\":\"100% Daily Value of Vitamin C per 8 FL OZ serving\"},{\"id\":\"1e7a31b9-c2dd-4cf4-a624-03582dc905bb\",\"key\":\"Consuming one serving (8 oz) each day of a cranberry juice beverage may help reduce the risk of recurrent urinary tract infection (UTI) in healthy women. FDA has concluded that the scientific evidence supporting this claim is limited and inconsistent.\",\"value\":\"\"}],\"disclaimer\":\"100% Vitamin C \\r\\n\\r\\n100% Daily Value of Vitamin C per 8 FL OZ serving  \",\"category\":\"[Circular]\",\"typeFilters\":[],\"benefitFilters\":[],\"hubSpotLabel\":\"The Original Cranberry Juice Cocktail\",\"dietaryFilters\":[],\"flavorFilters\":[],\"associatedRecipes\":[],\"destiniAssociationId\":\"CranberryJuiceCocktail64oz\",\"bvProductId\":\"CFBD1F39-554B-4E79-BB0D-85F7EC5496DD\",\"curalateProductId\":\"CFBD1F39-554B-4E79-BB0D-85F7EC5496DD-64 oz\",\"ogTitle\":\"Ocean Spray® Cranberry Juice Cocktail\",\"upc\":\"CFBD1F39-554B-4E79-BB0D-85F7EC5496DD\",\"sitecoreId\":\"{EB1538BA-F2FE-4476-B0BC-2C0D16D6EA46}\"}}]}},\"backgroundColor\":\"Magenta\",\"stickers\":[\"Fruity\",\"Fresh\"],\"destiniAssociationId\":\"WhiteCranStrawberryWhiteCranberryandStrawberryJuiceDrink64oz\",\"bvProductId\":\"CA9CB366-BEB1-4445-A505-23316B2F477D\",\"curalateProductId\":\"CA9CB366-BEB1-4445-A505-23316B2F477D-64 oz\",\"typeFilters\":[],\"benefitFilters\":[],\"dietaryFilters\":[],\"flavorFilters\":[],\"metaTitle\":\"Ocean Spray® White Cran x Strawberry™: Strawberry Juice Drink\",\"metaDescription\":\"Discover the exciting fusion of White Cranberry and Strawberry Juice in Ocean Spray's White Cran x Strawberry™. Experience the fun spin on traditional juice flavors.\",\"metaKeywords\":\"Juices and Drinks, White Cran Strawberry White Cranberry Strawberry Juice Drink\",\"ogTitle\":\"\",\"upc\":\"CA9CB366-BEB1-4445-A505-23316B2F477D\",\"sitecoreId\":\"{54578F10-A5F0-4769-BAAC-EBBDCDADA63E}\",\"associatedRecipes\":[],\"disclaimer\":\"100% Vitamin C \\r\\n\\r\\n100% Daily Value of Vitamin C per 8 