flavor-packed and delicious.\",\"value\":\"\"},{\"id\":\"e55faeaa-5d69-40c9-84e0-da6c6d684066\",\"key\":\"Made from real fruit.\",\"value\":\"\"},{\"id\":\"dd665350-66d4-488b-9d2a-49e155385de7\",\"key\":\"No artificial flavors or preservatives.\",\"value\":\"\"},{\"id\":\"55b81a1f-58bb-4ab3-a628-09bf05970818\",\"key\":\"Great for back-to-school lunches, road trips, or an afternoon pick-me-up.\",\"value\":\"\"},{\"id\":\"65c4c9c7-9dc3-4c71-9276-2a0c48d4949a\",\"key\":\"Sprinkle on desserts, mix into baked goods, or enjoy as a stand-alone snack.\",\"value\":\"\"}],\"countries\":[{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"4YhS9Pyt2s9lYDTnbwU7cg\",\"type\":\"Entry\",\"createdAt\":\"2023-12-06T22:07:30.385Z\",\"updatedAt\":\"2024-10-24T10:00:24.527Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":105,\"revision\":39,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"country\"}},\"locale\":\"en-US\"},\"fields\":{\"name\":\"United States\",\"tld\":\"com\",\"countryCode\":\"US\",\"languages\":[],\"headerMenus\":[],\"footerMenus\":[],\"newsletterHeading\":\"In Cran We Trust\",\"newsletterText\":\"Wave your cran flag high. Join now and get access to exclusive offers, the latest news from the bog, and new product sneak peeks.\",\"newsletterTermsConditionsText\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim\\n\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"legalHeading\":\"©2024 Ocean Spray\",\"destini\":\"oceanspray\",\"mikmak\":\"670032a57a1d7c0f07baae48\",\"bazaarVoice\":\"oceanspray\",\"curalate\":\"oceanspray-g0frjz\",\"bazaarVoiceSiteId\":\"main_site\",\"engineId\":\"j-As7u-eo3_Qc-Xhor-A\",\"gtm\":\"GTM-M7VQVSDN\",\"gtag\":\"G-CSHX9SKFN4\",\"gtmTest\":\"GTM-N8S9WFFH\",\"gtagTest\":\"G-LPKMNCGB2P\"}},{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"6X7SO3jiRPvvHenmxk3SsY\",\"type\":\"Entry\",\"createdAt\":\"2024-08-12T19:53:52.488Z\",\"updatedAt\":\"2024-08-12T19:53:52.488Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":6,\"revision\":1,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"country\"}},\"locale\":\"en-US\"},\"fields\":{\"name\":\"Jamaica\",\"tld\":\"com.jm\",\"countryCode\":\"JM\",\"languages\":[],\"headerMenus\":[],\"footerMenus\":[],\"newsletterHeading\":\"In Cran We Trust\",\"newsletterText\":\"Wave your cran flag high. Join now and get access to exclusive offers, the latest news from the bog, and new product sneak peeks.\",\"newsletterTermsConditionsText\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim\\n\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"legalHeading\":\"©2024 Ocean Spray\",\"destini\":\"oceanspray\",\"bazaarVoice\":\"oceanspray\",\"curalate\":\"oceanspray-g0frjz\",\"bazaarVoiceSiteId\":\"main_site\",\"engineId\":\"j-As7u-eo3_Qc-Xhor-A\",\"gtm\":\"GTM-M7VQVSDN\",\"gtag\":\"G-CSHX9SKFN4\",\"gtmTest\":\"GTM-N8S9WFFH\",\"gtagTest\":\"G-LPKMNCGB2P\"}}],\"category\":\"[Circular]\",\"backgroundColor\":\"Bright Red\",\"destiniAssociationId\":\"CraisinsDriedCranberriesCherryJuiceInfused\",\"bvProductId\":\"F0E05024-992A-4741-9371-533AEECF513A\",\"curalateProductId\":\"F0E05024-992A-4741-9371-533AEECF513A-6 oz\",\"typeFilters\":[],\"dietaryFilters\":[],\"flavorFilters\":[],\"metaTitle\":\"Ocean Spray® Craisins® Original Dried Cranberries: Cherry Juice Infused Snack\",\"metaDescription\":\"Experience the delightful burst of Ocean Spray® flavor in every bite with our Craisins® Original Dried Cranberries, artfully cherry juice-infused for a snack that's fun and full of zing!\",\"metaKeywords\":\"Craisins Dried Cranberries, Craisins Dried Cranberries Cherry Juice Infused\",\"ogTitle\":\"\",\"upc\":\"F0E05024-992A-4741-9371-533AEECF513A\",\"sitecoreId\":\"{BB772F78-6218-42D6-ACBD-C89A11CE0F7A}\",\"associatedRecipes\":[],\"disclaimer\":\"No artificial colors, flavors or preservatives, Gluten Free, Peanut Free, Made from Real Fruit\"}},{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"6S0lcHgXvvnzxoYmAmh0cX\",\"type\":\"Entry\",\"createdAt\":\"2024-02-13T13:24:19.942Z\",\"updatedAt\":\"2025-01-16T09:46:18.683Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":100,\"revision\":16,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"product\"}},\"locale\":\"en-US\"},\"fields\":{\"title\":\"Craisins® Dried Cranberries Blueberry Juice Infused\",\"slug\":\"craisins-dried-cranberries-blueberry-juice-infused-6-oz\",\"hubSpotLabel\":\"Craisins® Dried Cranberries Blueberry Juice Infused\",\"description\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Sweeten the day with Ocean Spray® Craisins® Blueberry Dried Cranberries. Mouth-watering flavor with uncanny nutrition. This cranberry dried fruit product is an easy way to work in 25% of your daily recommended fruit needs. No artificial flavors or preservatives. Enjoy real, bold dried cranberries infused with blueberry juice in every dried fruit pouch. Potent little puckers that are peanut-free, gluten-free and judgment-free. Top your weeknight salads. Mix them in your oatmeal or cereal. Use as baking ingredients in your favorite treats, like blueberry lemon cheesecake bars. Step up your entertaining game by adding their powerful flavor and color to apps, charcuterie boards and more. Transform boring lunches and snacks into something you look forward to eating. Can raisins do all that? Nope. They're also just really good on their own.\",\"marks\":[],\"data\":{}}]}]},\"frontImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"12KX88yRRYcDs4iOjsokFH\",\"type\":\"Asset\",\"createdAt\":\"2024-03-12T19:28:18.493Z\",\"updatedAt\":\"2024-03-12T19:28:18.493Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":2,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"Craisins® Dried Cranberries Blueberry Juice Infused\",\"description\":\"Craisins® Dried Cranberries Blueberry Juice Infused front image.\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b3/12KX88yRRYcDs4iOjsokFH/23c944e5045b152c2304eb798e2f9915/Craisins__Dried_Cranberries_Blueberry_Juice_Infused.png\",\"details\":{\"size\":1694884,\"image\":{\"width\":1000,\"height\":1400}},\"fileName\":\"Craisins® Dried Cranberries Blueberry Juice Infused.png\",\"contentType\":\"image/png\"}}},\"gtin\":\"00031200002327\",\"size\":\"6 oz\",\"nutritionalInfoImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"7xywGlxrBF3DrffWEKJpv4\",\"type\":\"Asset\",\"createdAt\":\"2024-09-10T19:02:39.198Z\",\"updatedAt\":\"2024-09-10T19:02:39.198Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":5,\"revision\":1