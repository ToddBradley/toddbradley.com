,\"legalHeading\":\"©2024 Ocean Spray\",\"destini\":\"oceanspray\",\"bazaarVoice\":\"oceanspray\",\"curalate\":\"oceanspray-g0frjz\",\"bazaarVoiceSiteId\":\"main_site\",\"engineId\":\"j-As7u-eo3_Qc-Xhor-A\",\"gtm\":\"GTM-M7VQVSDN\",\"gtag\":\"G-CSHX9SKFN4\",\"gtmTest\":\"GTM-N8S9WFFH\",\"gtagTest\":\"G-LPKMNCGB2P\"}}],\"gtin\":\"00031200001689\",\"slug\":\"craisins-50-less-sugar-dried-cranberries-5-oz\",\"frontImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"2dxNBaxiytQb9U82Y2hrkW\",\"type\":\"Asset\",\"createdAt\":\"2024-03-12T19:26:30.520Z\",\"updatedAt\":\"2024-03-12T19:26:30.520Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":2,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"Craisins® 50% Less Sugar Dried Cranberries\",\"description\":\"Craisins® 50% Less Sugar Dried Cranberries front image.\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b3/2dxNBaxiytQb9U82Y2hrkW/357476509855f6033166e3f42acdc561/Craisins__50__Less_Sugar_Dried_Cranberries.png\",\"details\":{\"size\":1678162,\"image\":{\"width\":1000,\"height\":1400}},\"fileName\":\"Craisins® 50% Less Sugar Dried Cranberries.png\",\"contentType\":\"image/png\"}}},\"description\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Mouth-watering flavor. 50% less sugar than Original Craisins® Dried Cranberries. Enjoy real, bold dried cranberries in every dried fruit pouch. Potent little puckers that are peanut-free, gluten-free and judgment-free. Top your weeknight salads. Mix them in your oatmeal or cereal. Use as baking ingredients in your favorite treats, like chewy dried cranberry oatmeal chocolate chunk cookies. Step up your entertaining game by adding their powerful flavor and color to apps, charcuterie boards and more.  They're also just really good on their own.\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"size\":\"5 oz\",\"nutritionalInfoImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"1cYBxOopSbzrKRJEzm7czF\",\"type\":\"Asset\",\"createdAt\":\"2025-12-04T17:13:22.907Z\",\"updatedAt\":\"2025-12-04T17:13:22.907Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":4,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"5oz OS Craisins Less Sugar Nutrition Facts Panel\",\"description\":\"5oz OS Craisins Less Sugar Nutrition Facts Panel\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b3/1cYBxOopSbzrKRJEzm7czF/a2fe65ff1acc3091b1e745051c99203b/5oz_OS_Craisins_Less_Sugar_CMB_7641__1.png\",\"details\":{\"size\":202001,\"image\":{\"width\":3000,\"height\":3000}},\"fileName\":\"5oz_OS_Craisins_Less_Sugar_CMB(7641)_1.png\",\"contentType\":\"image/png\"}}},\"nutritionalFacts\":[{\"id\":\"eae4968b-836e-4cbd-8b9a-36611c514f4f\",\"key\":\"No Artificial Flavors or Preservatives\",\"value\":\"\"},{\"id\":\"260b6716-ca24-4716-9541-4cefc7b5c0d5\",\"key\":\"50% Less Sugar\",\"value\":\"Than Original Craisins® Dried Cranberries.**\"},{\"id\":\"b5e81a54-0b4c-4686-8cf8-144e3398e2e3\",\"key\":\"Excellent Source of Fiber\",\"value\":\"\"},{\"id\":\"3b9daacc-845c-4e62-9085-07e2e445357a\",\"key\":\"Peanut Free\",\"value\":\"\"},{\"id\":\"5e055d5a-a968-4cc3-9b4a-afa9c92b5624\",\"key\":\"Gluten Free\",\"value\":\"\"},{\"id\":\"329fe6a2-d6ba-4693-bb34-6f2df2facd61\",\"key\":\"Made from Real Fruit\",\"value\":\"\"},{\"id\":\"5b2fe7d8-2aa3-4d0e-93c0-38f759d212ed\",\"key\":\"Multi serve: 50% Less Sugar**\",\"value\":\"**This product contains 14 g sugar compared to 29 g sugar per serving of Craisins® Original Dried Cranberries\"}],\"disclaimer\":\"No artificial colors, flavors or preservatives, 50% Less Sugar**\\n**Compared to Original Craisins® Dried Cranberries, Excellent Source of Fiber , Peanut Free , Gluten Free, Made from real fruit\",\"category\":\"[Circular]\",\"typeFilters\":[],\"benefitFilters\":[],\"hubSpotLabel\":\"Craisins® 50% Less Sugar Dried Cranberries\",\"dietaryFilters\":[],\"flavorFilters\":[],\"associatedRecipes\":[],\"destiniAssociationId\":\"ReducedSugarCraisinsDriedCranberries\",\"bvProductId\":\"DEB6ADA1-A04A-457C-9B91-13A553C7422B\",\"curalateProductId\":\"DEB6ADA1-A04A-457C-9B91-13A553C7422B-5 oz\",\"ogTitle\":\"\",\"upc\":\"DEB6ADA1-A04A-457C-9B91-13A553C7422B\",\"sitecoreId\":\"{B489E657-E993-4DFE-AC61-C1FD7956C2E4}\"}},{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"20pJBKOatW3uRKoD33h2vA\",\"type\":\"Entry\",\"createdAt\":\"2024-02-13T13:24:27.561Z\",\"updatedAt\":\"2025-01-16T09:45:59.977Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":94,\"revision\":14,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"product\"}},\"locale\":\"en-US\"},\"fields\":{\"title\":\"Craisins® Dried Cranberries Pomegranate Juice Infused\",\"slug\":\"craisins-dried-cranberries-pomegranate-juice-infused-6-oz\",\"hubSpotLabel\":\"Craisins® Dried Cranberries Pomegranate Juice Infused\",\"description\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Sweeten the day with Ocean Spray® Craisins® Pomegranate Dried Cranberries. Mouth-watering flavor with uncanny nutrition. This cranberry dried fruit product is an easy way to work in 25% of your daily recommended fruit needs. No artificial flavors or preservatives. Enjoy real, bold dried cranberries infused with pomegranate juice in every dried fruit pouch. Potent little puckers that are peanut-free, gluten-free and judgment-free. Top your weeknight salads. Mix them in your oatmeal or cereal. Use as baking ingredients in your favorite treats, like chewy cranberry chocolate chip cookies. Step up your entertaining game by adding their powerful flavor and color to apps, charcuterie boards and more. Transform boring lunches and snacks into something you look forward to eating. Can raisins do all that? Nope. They're also just really good on their own.\",\"marks\":[],\"data\":{}}]}]},\"frontImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"4ofzLRW2zweVh0p1z7kDVl\",\"type\":\"Asset\",\"createdAt\":\"2024-03-12T19:30:20.418Z\",\"updatedAt\":\"2024-03-12T19:30:20.418Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":2,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"Craisins® Dried Cranberries Pomegranate Juice Infused\",\"description\":\"Craisins® Dried Cranberries Pomegranate Juice Infused front image.\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b3/4ofzLRW2zweVh0p1z7kDVl/12799debc5b8483308a68c9440a33265/Craisins__Dried_Cranberries_Pomegranate_Juice_Infused.png\",\"details\":{\"size\":1731584,\"image\":{\"width\":1000,\"height\":1400}},\"fileName\":\"Craisins® Dried Cranberries Pomegranate Juice Infused.png\",\"contentType\":\"image/png\"}}},\"gtin\":\"00031200002334\",\"size\":\"6 oz\",\"nutritionalInfoImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"4krMDOT7bHopDX3DLFzJyY\",\"type\":\"Asset\",\"createdAt\":\"2024-09-10T19:02:39.141Z\",\"updatedAt\":\"2024-09-10T19:02:39.141Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":5,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"Pomegranate 6oz Pouch NFP 1 Ingredients\",\"description\":\"Image for P