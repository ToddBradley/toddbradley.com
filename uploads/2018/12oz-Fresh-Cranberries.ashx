.\\r\\nOcean Spray® fresh raspberries are passionately grown and hand-picked to come straight from the farm to your family.\\r\\n\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"frontImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"4vT2fGrJ5CIjerBl41EgTD\",\"type\":\"Asset\",\"createdAt\":\"2024-03-12T19:15:58.555Z\",\"updatedAt\":\"2024-03-12T19:15:58.555Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":2,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"Raspberries\",\"description\":\"Raspberries front image.\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b3/4vT2fGrJ5CIjerBl41EgTD/9ce023fba088c41c1ae4680ebbbe4843/Raspberries.png\",\"details\":{\"size\":447647,\"image\":{\"width\":1000,\"height\":1062}},\"fileName\":\"Raspberries.png\",\"contentType\":\"image/png\"}}},\"gtin\":\"00066022005706\",\"size\":\"6 oz\",\"nutritionalInfoImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"3SZIl1msW8N2M6yn0hDgnG\",\"type\":\"Asset\",\"createdAt\":\"2024-09-06T18:35:17.697Z\",\"updatedAt\":\"2024-09-06T18:35:17.697Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":6,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"Raspberries Nutritional Ingredients\",\"description\":\"Image for Raspberries Nutritional Ingredients\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b3/3SZIl1msW8N2M6yn0hDgnG/c1fdf290118fd680fc14ccc159cf4e88/Raspberries_nutrition_facts.jpg\",\"details\":{\"size\":37309,\"image\":{\"width\":305,\"height\":425}},\"fileName\":\"Raspberries_nutrition_facts.jpg\",\"contentType\":\"image/jpeg\"}}},\"nutritionalFacts\":[],\"countries\":[{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Li