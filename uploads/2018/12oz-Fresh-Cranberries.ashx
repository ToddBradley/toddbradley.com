\"2025-01-16T09:45:59.977Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":94,\"revision\":14,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"product\"}},\"locale\":\"en-US\"},\"fields\":{\"title\":\"Craisins® Dried Cranberries Pomegranate Juice Infused\",\"slug\":\"craisins-dried-cranberries-pomegranate-juice-infused-6-oz\",\"hubSpotLabel\":\"Craisins® Dried Cranberries Pomegranate Juice Infused\",\"description\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Sweeten the day with Ocean Spray® Craisins® Pomegranate Dried Cranberries. Mouth-watering flavor with uncanny nutrition. This cranberry dried fruit product is an easy way to work in 25% of your daily recommended fruit needs. No artificial flavors or preservatives. Enjoy real, bold dried cranberries infused with pomegranate juice in every dried fruit pouch. Potent little puckers that are peanut-free, gluten-free and judgment-free. Top your weeknight salads. Mix them in your oatmeal or cereal. Use as baking ingredients in your favorite treats, like chewy cranberry chocolate chip cookies. Step up your entertaining game by adding their powerful flavor and color to apps, charcuterie boards and more. Transform boring lunches and snacks into something you look forward to eating. Can raisins do all that? Nope. They're also just really good on their own.\",\"marks\":[],\"data\":{}}]}]},\"frontImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"4ofzLRW2zweVh0p1z7kDVl\",\"type\":\"Asset\",\"createdAt\":\"2024-03-12T19:30:20.418Z\",\"updatedAt\":\"2024-03-12T19:30:20.418Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":2,\"revision\":1,\"locale\":\"en-US\"},\"f