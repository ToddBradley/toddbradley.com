e\":\"oceanspray\",\"curalate\":\"oceanspray-g0frjz\",\"bazaarVoiceSiteId\":\"main_site\",\"engineId\":\"j-As7u-eo3_Qc-Xhor-A\",\"gtm\":\"GTM-M7VQVSDN\",\"gtag\":\"G-CSHX9SKFN4\",\"gtmTest\":\"GTM-N8S9WFFH\",\"gtagTest\":\"G-LPKMNCGB2P\"}}],\"category\":\"[Circular]\",\"backgroundColor\":\"Bright Red\",\"destiniAssociationId\":\"Snack_Medley\",\"bvProductId\":\"4F1019CE-38F1-4930-89C8-A142E6F2F3A3\",\"curalateProductId\":\"4F1019CE-38F1-4930-89C8-A142E6F2F3A3-5/1 oz\",\"typeFilters\":[],\"dietaryFilters\":[],\"flavorFilters\":[],\"metaTitle\":\"Ocean Spray® Pineapple Cran™ Snack Medley - Tropical Fruit Snack\",\"metaDescription\":\"Dive into the tropical delight of Ocean Spray® Pineapple Cran™ Snack Medley. This fruity treat is a mouthwatering medley of Ocean Spray pineapple cranberry blend and nuts!\",\"metaKeywords\":\"Craisins Dried Cranberries, Ocean Spray® Pineapple Cran™ Snack Medley\",\"ogTitle\":\"\",\"upc\":\"4F1019CE-38F1-4930-89C8-A142E6F2F3A3\",\"sitecoreId\":\"{4F1019CE-38F1-4930-89C8-A142E6F2F3A3}\",\"associatedRecipes\":[],\"disclaimer\":\"Made from real fruit\\r\\nNo artificial colors, flavors or preservatives\\r\\nNo high fructose corn syrup\\r\\nNo artificial sweeteners\\r\\n\"}},\"[Circular]\",{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"1CFwoAVFNgZcGIMv4an7FZ\",\"type\":\"Entry\",\"createdAt\":\"2024-02-13T13:24:48.547Z\",\"updatedAt\":\"2025-01-17T16:12:29.945Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":65,\"revision\":16,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"product\"}},\"locale\":\"en-US\"},\"fields\":{\"title\":\"Greek Yogurt Flavored Dipped Cranberry Bites\",\"slug\":\"greek-yogurt-cranberry-bites-8-oz\",\"hubSpotLabel\":\"Greek Yogurt Flavored Dipped Cranberry Bites\",\"description\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Bold cranberry flavor. Smooth creamy coating. Ocean Spray® Greek Yogurt Covered Dried Cranberries. The cranberries you love with creamy Greek yogurt flavor. Enjoy the benefits of cranberry, even more. Real, bold dried cranberries dipped in a satisfying Greek yogurt flavored coating in every dried fruit pouch. Enjoy these little tangy treats as on the go snacks. Stash in your desk drawer. Share with friends and family. Or…don't. Stay in. Cozy up on that couch. Sprinkle over your favorite ice cream. And dig in. You and your taste buds deserve it. Step up your entertaining game by adding their bold flavor to apps, charcuterie boards and more. They're also just really good on their own.\",\"marks\":[],\"data\":{}}]}]},\"frontImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"39oCe7UJYHtOWtPhDAbCfX\",\"type\":\"Asset\",\"createdAt\":\"2024-11-01T10:10:00.482Z\",\"updatedAt\":\"2024-11-01T10:10:00.482Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":3,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"8oz OS Greek Yogurt Cran Bites front(00002 0000024453)(5837)\",\"description\":\"\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b3/39oCe7UJYHtOWtPhDAbCfX/dd11664558b09d7a1c5dd65e341c7aa1/8oz_OS_Greek_Yogurt_Cran_Bites_front_00002_0000024453__5837_.png\",\"details\":{\"size\":5857741,\"image\":{\"width\":3000,\"height\":3000}},\"fileName\":\"8oz_OS_Greek_Yogurt_Cran_Bites_front(00002_0000024453)(5837).png\",\"contentType\":\"image/png\"}}},\"gtin\":\"00031200037190\",\"size\":\"8 oz\",\"nutritionalInfoImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv