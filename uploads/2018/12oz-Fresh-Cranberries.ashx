ilters\":[],\"flavorFilters\":[],\"metaTitle\":\"Ocean Spray® Greek Yogurt Cranberry Bites - Fruit-infused Snack Products\",\"metaDescription\":\"Indulge in the delectable delight of Ocean Spray® Greek Yogurt Cranberry Bites. A perfect blend of fruit-infused yogurt bites and snack products from your favorite brand.\",\"metaKeywords\":\"Craisins Dried Cranberries, Greek Yogurt Covered Craisins Dried Cranberries\",\"ogTitle\":\"\",\"upc\":\"C53D3986-754E-4FD4-BFDE-63FCB21E2974\",\"sitecoreId\":\"{73E6D59F-4865-491A-A0CD-55C2C27AA789}\",\"associatedRecipes\":[],\"disclaimer\":\"Made from real fruit\\r\\nNo artificial colors, no preservatives\\r\\n\"}}]}},\"backgroundColor\":\"Gold\",\"illustration\":\"Juice Bottle\",\"stickers\":[\"Kid-Approved\",\"Refresh\"],\"featuredProducts\":[{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"Awz0tLUrEZHNh76xmabfc\",\"type\":\"Entry\",\"createdAt\":\"2024-02-13T13:25:41.529Z\",\"updatedAt\":\"2025-01-16T09:55:27.194Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":62,\"revision\":16,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"product\"}},\"locale\":\"en-US\"},\"fields\":{\"title\":\"Pineapple Cran™ Snack Medley\",\"slug\":\"ocean-spray-pineapple-cran-snack-medley-5-1-oz\",\"hubSpotLabel\":\"Pineapple Cran™ Snack Medley\",\"description\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Big bold flavors. Perfectly portioned. Ocean Spray® Pineapple Cran™ Snack Medley. The cranberry flavor you know and love, paired with tropical pineapple for the ultimate sweet and tangy fruit snack experience. Enjoy a dried fruit snack pack anytime, anywhere. Lunch snacks at school. Afternoon bites on the way to practice. Late-night cravings on road trips. It's always the right time for these single serve snacks. Made from real fruit for the bold flavor of dried cranberries and dried pineapples. Transform boring lunches into mic-dropping meals. Top your morning parfait. Mix them in your oatmeal or yogurt. Take them as nutritious on the go snacks during weekend errands. Other snacks couldn't keep up if they tried. However you eat them, don't let anything stand in the way of your Ocean Spray® Pineapple Cran™ Snack Medley fix. They're perfectly portioned, individual snacks for your busy life. Ocean Spray believes in the power of the mighty cranberry; Born Tart. Raised Bold.™\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"frontImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"6XY4vaP1xLsO0bRt5ZiWoT\",\"type\":\"Asset\",\"createdAt\":\"2024-03-12T19:17:55.941Z\",\"updatedAt\":\"2024-03-12T19:17:55.941Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":2,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"Ocean Spray® Pineapple Cran™ Snack Medley\",\"description\":\"Ocean Spray® Pineapple Cran™ Snack Medley front image.\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b3/6XY4vaP1xLsO0bRt5ZiWoT/d879bbdaca99baf531affc4ab4aef5c4/Ocean_Spray__Pineapple_Cran__Snack_Medley.png\",\"details\":{\"size\":630343,\"image\":{\"width\":1000,\"height\":1400}},\"fileName\":\"Ocean Spray® Pineapple Cran™ Snack Medley.png\",\"contentType\":\"image/png\"}}},\"gtin\":\"00031200022080\",\"size\":\"5/1 oz\",\"nutritionalInfoImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"2i0IAoqLI1PfN9Vf9TCct9\",\"type\":\"Asset\",\"createdAt\":\"2024-09-10T18:38:40.999Z\",\"updatedAt\":\"2024-09-10T18:38:40.999Z\",\"environment\":{\"sys\