T13:23:59.559Z\",\"updatedAt\":\"2025-01-16T09:45:20.429Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":67,\"revision\":16,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"product\"}},\"locale\":\"en-US\"},\"fields\":{\"title\":\"Rum Punch Cocktail Mixer\",\"slug\":\"rum-punch-cocktail-mixer-32-oz\",\"hubSpotLabel\":\"Rum Punch Cocktail Mixer\",\"description\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"A perfectly balanced mix of tropical flavors ready in seconds. Just add rum to Ocean Spray® Rum Punch Cocktail Mixer for a restaurant quality drink at home. Made from real fruit juice and less sugar than the leading mixer, this rum punch mix offers balanced fruity flavor for beverages with tropical vacation taste and at-home ease. Make a splash and impress guests with this rum punch drink mixer; perfect for creating effortlessly excellent cocktails for big and small gatherings and special events. Whether you're stirring in your favorite rum or trying something new, this drink mix makes a bold, refreshing beverage every time. Ocean Spray® also offers other delicious drink mixers for your favorite cocktails in seconds. We believe in uncommonly bold mashups.\",\"marks\":[],\"data\":{}}]}]},\"frontImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"2VAbroB2oMmh7aEJ2Wgef0\",\"type\":\"Asset\",\"createdAt\":\"2024-03-12T19:29:17.509Z\",\"updatedAt\":\"2024-03-12T19:29:17.509Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":2,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"Rum Punch Cocktail Mixer\",\"description\":\"Rum Punch Cocktail Mixer front image.\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b