y\",\"createdAt\":\"2023-12-06T22:07:30.385Z\",\"updatedAt\":\"2024-10-24T10:00:24.527Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":105,\"revision\":39,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"country\"}},\"locale\":\"en-US\"},\"fields\":{\"name\":\"United States\",\"tld\":\"com\",\"countryCode\":\"US\",\"languages\":[],\"headerMenus\":[],\"footerMenus\":[],\"newsletterHeading\":\"In Cran We Trust\",\"newsletterText\":\"Wave your cran flag high. Join now and get access to exclusive offers, the latest news from the bog, and new product sneak peeks.\",\"newsletterTermsConditionsText\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim\\n\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"legalHeading\":\"©2024 Ocean Spray\",\"destini\":\"oceanspray\",\"mikmak\":\"670032a57a1d7c0f07baae48\",\"bazaarVoice\":\"oceanspray\",\"curalate\":\"oceanspray-g0frjz\",\"bazaarVoiceSiteId\":\"main_site\",\"engineId\":\"j-As7u-eo3_Qc-Xhor-A\",\"gtm\":\"GTM-M7VQVSDN\",\"gtag\":\"G-CSHX9SKFN4\",\"gtmTest\":\"GTM-N8S9WFFH\",\"gtagTest\":\"G-LPKMNCGB2P\"}}],\"gtin\":\"031200008374\",\"slug\":\"zero-sugar-strawberry-mango\",\"frontImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"4RtSXVn4FUA2SWGqoyI1Oi\",\"type\":\"Asset\",\"createdAt\":\"2025-06-27T15:14:37.462Z\",\"updatedAt\":\"2025-06-27T15:14:37.462Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":7,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"Zero Sugar Strawberry Mango \",\"description\":\"Zero Sugar Strawberry Mango 10oz Multipack\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b3/4RtSXVn4FUA2SWGqoyI1Oi/eb382abe08ce7996b7d3bbc930472b5d/10oz_Multipack_ZS_StrawberryMango_front_7273_.png\",\"details\":{\"size\":9179027,\"image\":{\"width\":3000,\"height\":3000}},\"fileName\":\"10oz_Multipack_ZS_StrawberryMango_front(7273).png\",\"contentType\":\"image/png\"}}},\"description\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Zero sugar. Bold flavor. Try Ocean Spray® ZERO Sugar Strawberry Mango Juice Drink. Experience sweet strawberries and tropical mango flavors without compromise. This radically refreshing juice drink is made from real fruit juice, 0g of sugar per 8 fl oz serving and no artificial sweeteners†. Just stevia sweetener from stevia leaf extract for a tasty beverage your entire family can feel good about. It's also an excellent source of vitamin C. Ocean Spray® ZERO Sugar Strawberry Mango Juice Drink is a tasty thirst-quencher that adds a flavor-packed punch to any meal. Enjoy at home, take it on the go or use it as a zero-sugar cocktail mixer for beverages that don't trade sugar for taste. This 10 fl oz 6-pack is perfect for sharing, but the bold, delicious taste might make you want to keep it all to yourself. Try other Ocean Spray® ZERO flavors for absolutely delicious, zero sugar juice drink options. (†) Contains stevia leaf extract, which has been further processed.\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"size\":\"6/10 oz\",\"nutritionalInfoImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"632bkSvB07xX9ToDDnEPXZ\",\"type\":\"Asset\",\"createdAt\":\"2025-06-27T15:16:02.364Z\",\"updatedAt\":\"2025-06-27T15:16:02.364Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":8,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"Zero Sugar Strawberry Mango Nutrition Facts \",\"description\":\"Zero Sugar Strawberry Mango (10oz multipack) Nutrition Facts Panel\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b3/632bkSvB07xX9ToDDnEPXZ/4e81ddd2951a6779efd07e286c9b1ad9/10oz_Multipack_ZS_StrawberryMango_CMB_7273_.png\",\"details\":{\"size\":210645,\"image\":{\"width\":3000,\"height\":3000}},\"fileName\":\"10oz_Multipack_ZS_StrawberryMango_CMB(7273).png\",\"contentType\":\"image/png\"}}},\"nutritionalFacts\":[{\"id\":\"564da3bc-9906-4041-bce5-b93857867b79\",\"key\":\"Zero Sugar\",\"value\":\"This product is a low calorie food\"},{\"id\":\"aaa56f62-14d5-4134-86f1-a5360d0b18f7\",\"key\":\"No Artificial Sweeteners*\",\"value\":\"*Contains stevia leaf extract, which has been further processed\"},{\"id\":\"4a6105d5-57e3-401e-8e08-bae46794b7fe\",\"key\":\"Excellent Source of Vitamin C\",\"value\":\"\"}],\"category\":{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"fr\"}},{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"mwQK5Qykqzzddl68NqdEF\",\"type\":\"Entry\",\"createdAt\":\"2023-12-07T17:14:28.456Z\",\"updatedAt\":\"2025-05-01T16:37:21.301Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":1150,\"revision\":14,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"productCategory\"}},\"locale\":\"en-US\"},\"fields\":{\"slug\":\"juices\",\"name\":\"Juices \u0026 Juice Drinks\",\"countries\":[{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"4YhS9Pyt2s9lYDTnbwU7cg\",\"type\":\"Entry\",\"createdAt\":\"2023-12-06T22:07:30.385Z\",\"updatedAt\":\"2024-10-24T10:00:24.527Z\",\"environment\":{\"s