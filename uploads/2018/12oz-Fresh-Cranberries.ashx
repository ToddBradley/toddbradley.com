,\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"legalHeading\":\"©2024 Ocean Spray\",\"destini\":\"oceanspray\",\"mikmak\":\"670032a57a1d7c0f07baae48\",\"bazaarVoice\":\"oceanspray\",\"curalate\":\"oceanspray-g0frjz\",\"bazaarVoiceSiteId\":\"main_site\",\"engineId\":\"j-As7u-eo3_Qc-Xhor-A\",\"gtm\":\"GTM-M7VQVSDN\",\"gtag\":\"G-CSHX9SKFN4\",\"gtmTest\":\"GTM-N8S9WFFH\",\"gtagTest\":\"G-LPKMNCGB2P\"}},{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"1IujG5SvWHeHfQvMpYPkrj\",\"type\":\"Entry\",\"createdAt\":\"2023-12-06T22:09:06.688Z\",\"updatedAt\":\"2024-11-08T09:10:19.229Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":34,\"revision\":13,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"country\"}},\"locale\":\"en-US\"},\"fields\":{\"name\":\"Canada\",\"tld\":\"ca\",\"countryCode\":\"CA\",\"languages\":[],\"legalHeading\":\"©[YEAR] Ocean Spray\",\"destini\":\"oceanspray\",\"mikmak\":\"672d13be02c77e0f0dcd5fb8\",\"bazaarVoice\":\"oceanspray\",\"curalate\":\"oceanspray\",\"bazaarVoiceSiteId\":\"main_site\"}}],\"title\":\"Craisins® Dried Cranberries\",\"themeColor\":\"Red\",\"backgroundText\":\"Dried \u0026 True\",\"shortDescription\":\"The category landing page for Craisins®.\",\"featuredProducts\":[\"[Circular]\",{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"20pJBKOatW3uRKoD33h2vA\",\"type\":\"Entry\",\"createdAt\":\"2024-02-13T13:24:27.561Z\",\"updatedAt\":\"2025-01-16T09:45:59.977Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":94,\"revision\":14,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"product\"}},\"locale\":\"en-US\"},\"fields\":{\"title\":\"Craisins® Dried Cranberries Pomegranate Juice Infused\",\"slug\":\"craisins-dried-cranberries-pomegranate-juice-infused-6-oz\",\"hubSpotLabel\":\"Craisins® Dried Cranberries Pomegranate Juice Infused\",\"description\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Sweeten the day with Ocean Spray® Craisins® Pomegranate Dried Cranberries. Mouth-watering flavor with uncanny nutrition. This cranberry dried fruit product is an easy way to work in 25% of your daily recommended fruit needs. No artificial flavors or preservatives. Enjoy real, bold dried cranberries infused with pomegranate juice in every dried fruit pouch. Potent little puckers that are peanut-free, gluten-free and judgment-free. Top your weeknight salads. Mix them in your oatmeal or cereal. Use as baking ingredients in your favorite treats, like chewy cranberry chocolate chip cookies. Step up your entertaining game by adding their powerful flavor and color to apps, charcuterie boards and more. Transform boring lunches and snacks into something you look forward to eating. Can raisins do all that? Nope. They're also just really good on their own.\",\"marks\":[],\"data\":{}}]}]},\"frontImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"4ofzLRW2zweVh0p1z7kDVl\",\"type\":\"Asset\",\"createdAt\":\"2024-03-12T19:30:20.418Z\",\"updatedAt\":\"2024-03-12T19:30:20.418Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":2,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"Craisins® Dried Cranberries Pomegranate Juice Infused\",\"description\":\"Craisins® Dried Cranberries Pomegranate Juice Infused front image.\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b3/4ofzLRW2zweVh0p1z7kDVl/12799debc5b8