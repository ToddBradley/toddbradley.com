ace\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"48JWsEo6LLhMqeq8gvOykb\",\"type\":\"Entry\",\"createdAt\":\"2024-02-27T20:37:40.615Z\",\"updatedAt\":\"2025-01-14T21:22:54.156Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":213,\"revision\":14,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"moduleDialogCookies\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"[Default] Cookie Modal\",\"title\":\"Cookie Information\",\"heading\":\"We use cookies\",\"bodyText\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"We use cookies to collect information about you. We use this information:\u2028\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"},{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"to give you a better experience of our website (functional)\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"list-item\"},{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"to count the pages you visit (statistics)\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"list-item\"},{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"to serve you relevant promotions (marketing)\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"list-item\"}],\"nodeType\":\"ordered-list\"},{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Click “OK” to give us your consent to use cookies for all these purposes. You can also use the checkboxes to consent to specific purposes. Select purposes and “Save settings”.Withdraw or change your consent at any time by clicking the icon in the bottom left corner of the screen. Change your settings. Read more about how we use cookies and other technologies to collect