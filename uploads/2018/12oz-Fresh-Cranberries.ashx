ks.\",\"newsletterTermsConditionsText\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim\\n\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"legalHeading\":\"©2024 Ocean Spray\",\"destini\":\"oceanspray\",\"mikmak\":\"670032a57a1d7c0f07baae48\",\"bazaarVoice\":\"oceanspray\",\"curalate\":\"oceanspray-g0frjz\",\"bazaarVoiceSiteId\":\"main_site\",\"engineId\":\"j-As7u-eo3_Qc-Xhor-A\",\"gtm\":\"GTM-M7VQVSDN\",\"gtag\":\"G-CSHX9SKFN4\",\"gtmTest\":\"GTM-N8S9WFFH\",\"gtagTest\":\"G-LPKMNCGB2P\"}}],\"category\":\"[Circular]\",\"backgroundColor\":\"Bright Red\",\"destiniAssociationId\":\"Snack_Medley\",\"bvProductId\":\"12094292-A369-4FA5-BFCB-42EE70D16EE8\",\"curalateProductId\":\"12094292-A369-4FA5-BFCB-42EE70D16EE8-5/1 oz\",\"typeFilters\":[],\"dietaryFilters\":[],\"flavorFilters\":[],\"metaTitle\":\"Buy Ocean Spray® Snacks: Healthy Mango Cranberry \u0026 Fruit Medley\",\"metaDescription\":\"Dive into Ocean Spray's Mango Cran Snack Medley, a pouch of juicy contradiction. Challenge your taste buds with our healthy Ocean Spray® Products.\",\"metaKeywords\":\"Craisins Dried Cranberries, Ocean Spray® Mango Cran™ Snack Medley\",\"ogTitle\":\"\",\"upc\":\"12094292-A369-4FA5-BFCB-42EE70D16EE8\",\"sitecoreId\":\"{12094292-A369-4FA5-BFCB-42EE70D16EE8}\",\"associatedRecipes\":[],\"disclaimer\":\"Made from real fruit\\r\\nNo artificial colors, flavors or preservatives\\r\\nNo high fructose corn syrup\\r\\nNo artificial sweeteners\\r\\n\"}},{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"1CFwoAVFNgZcGIMv4an7FZ\",\"type\":\"Entry\",\"createdAt\":\"2024-02-13T13:24:48.547Z\",\"updatedAt\":\"2025-01-17T16:12:29.945Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":65,\"revision\":16,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"product\"}},\"locale\":\"en-US\"},\"fields\":{\"title\":\"Greek Yogurt Flavored Dipped Cranberry Bites\",\"slug\":\"greek-yogurt-cranberry-bites-8-oz\",\"hubSpotLabel\":\"Greek Yogurt Flavored Dipped Cranberry Bites\",\"description\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Bold cranberry flavor. Smooth creamy coating. Ocean Spray® Greek Yogurt Covered Dried Cranberries. The cranberries you love with creamy Greek yogurt flavor. Enjoy the benefits of cranberry, even more. Real, bold dried cranberries dipped in a satisfying Greek yogurt flavored coating in every dried fruit pouch. Enjoy these little tangy treats as on the go snacks. Stash in your desk drawer. Share with friends and family. Or…don't. Stay in. Cozy up on that couch. Sprinkle over your favorite ice cream. And dig in. You and your taste buds deserve it. Step up your entertaining game by adding their bold flavor to apps, charcuterie boards and more. They're also just really good on their own.\",\"marks\":[],\"data\":{}}]}]},\"frontImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"39oCe7UJYHtOWtPhDAbCfX\",\"type\":\"Asset\",\"createdAt\":\"2024-11-01T10:10:00.482Z\",\"updatedAt\":\"2024-11-01T10:10:00.482Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":3,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"8oz OS Greek Yogurt Cran Bites front(00002 0000024453)(5837)\",\"description\":\"\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b3/39oCe7UJYHtOWtPhDAbCfX/dd11664558b09d7a1c5dd65e341c7aa1/8oz_OS_Greek_Yogurt_Cran_