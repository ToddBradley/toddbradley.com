\"}],\"countries\":[{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"4YhS9Pyt2s9lYDTnbwU7cg\",\"type\":\"Entry\",\"createdAt\":\"2023-12-06T22:07:30.385Z\",\"updatedAt\":\"2024-10-24T10:00:24.527Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":105,\"revision\":39,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"country\"}},\"locale\":\"en-US\"},\"fields\":{\"name\":\"United States\",\"tld\":\"com\",\"countryCode\":\"US\",\"languages\":[],\"headerMenus\":[],\"footerMenus\":[],\"newsletterHeading\":\"In Cran We Trust\",\"newsletterText\":\"Wave your cran flag high. Join now and get access to exclusive offers, the latest news from the bog, and new product sneak peeks.\",\"newsletterTermsConditionsText\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim\\n\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"legalHeading\":\"©2024 Ocean Spray\",\"destini\":\"oceanspray\",\"mikmak\":\"670032a57a1d7c0f07baae48\",\"bazaarVoice\":\"oceanspray\",\"curalate\":\"oceanspray-g0frjz\",\"bazaarVoiceSiteId\":\"main_site\",\"engineId\":\"j-As7u-eo3_Qc-Xhor-A\",\"gtm\":\"GTM-M7VQVSDN\",\"gtag\":\"G-CSHX9SKFN4\",\"gtmTest\":\"GTM-N8S9WFFH\",\"gtagTest\":\"G-LPKMNCGB2P\"}},{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"6X7SO3jiRPvvHenmxk3SsY\",\"type\":\"Entry\",\"createdAt\":\"2024-08-12T19:53:52.488Z\",\"updatedAt\":\"2024-08-12T19:53:52.488Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkTyp