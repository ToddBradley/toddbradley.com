\",\"mikmak\":\"670032a57a1d7c0f07baae48\",\"bazaarVoice\":\"oceanspray\",\"curalate\":\"oceanspray-g0frjz\",\"bazaarVoiceSiteId\":\"main_site\",\"engineId\":\"j-As7u-eo3_Qc-Xhor-A\",\"gtm\":\"GTM-M7VQVSDN\",\"gtag\":\"G-CSHX9SKFN4\",\"gtmTest\":\"GTM-N8S9WFFH\",\"gtagTest\":\"G-LPKMNCGB2P\"}},{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"1IujG5SvWHeHfQvMpYPkrj\",\"type\":\"Entry\",\"createdAt\":\"2023-12-06T22:09:06.688Z\",\"updatedAt\":\"2024-11-08T09:10:19.229Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":34,\"revision\":13,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"country\"}},\"locale\":\"en-US\"},\"fields\":{\"name\":\"Canada\",\"tld\":\"ca\",\"countryCode\":\"CA\",\"languages\":[],\"legalHeading\":\"©[YEAR] Ocean Spray\",\"destini\":\"oceanspray\",\"mikmak\":\"672d13be02c77e0f0dcd5fb8\",\"bazaarVoice\":\"oceanspray\",\"curalate\":\"oceanspray\",\"bazaarVoiceSiteId\":\"main_site\"}}],\"title\":\"Snacks\",\"themeColor\":\"White Cranberry\",\"backgroundText\":\"nom nom\",\"shortDescription\":\"The category landing page for snacks.\",\"featuredProducts\":[{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"Awz0tLUrEZHNh76xmabfc\",\"type\":\"Entry\",\"createdAt\":\"2024-02-13T13:25:41.529Z\",\"updatedAt\":\"2025-01-16T09:55:27.194Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":62,\"revision\":16,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"product\"}},\"locale\":\"en-US\"},\"fields\":{\"title\":\"Pineapple Cran™ Snack Medley\",\"slug\":\"ocean-spray-pineapple-cran-snack-medley-5-1-oz\",\"hubSpotLabel\":\"Pineapple Cran™ Snack Medley\",\"description\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Big bold flavors. Perfectly portioned. Ocean Spray® Pineapple Cran™ Snack Medley. The cranberry flavor you know and love, paired with tropical pineapple for the ultimate sweet and tangy fruit snack experience. Enjoy a dried fruit snack pack anytime, anywhere. Lunch snacks at school. Afternoon bites on the way to practice. Late-night cravings on road trips. It's always the right time for these single serve snacks. Made from real fruit for the bold flavor of dried cranberries and dried pineapples. Transform boring lunches into mic-dropping meals. Top your morning parfait. Mix them in your oatmeal or yogurt. Take them as nutritious on the go snacks during weekend errands. Other snacks couldn't keep up if they tried. However you eat them, don't let anything stand in the way of your Ocean Spray® Pineapple Cran™ Snack Medley fix. They're perfectly portioned, individual snacks for your busy life. Ocean Spray believes in the power of the mighty cranberry; Born Tart. Raised Bold.™\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"frontImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"6XY4vaP1xLsO0bRt5ZiWoT\",\"type\":\"Asset\",\"createdAt\":\"2024-03-12T19:17:55.941Z\",\"updatedAt\":\"2024-03-12T19:17:55.941Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":2,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"Ocean Spray® Pineapple Cran™ Snack Medley\",\"description\":\"Ocean Spray® Pineapple Cran™ Snack Medley front image.\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b3/6XY4vaP1xLsO0bRt5ZiWoT/d879bbdaca99baf531affc4ab4aef5c4/Ocean_Spray__Pineapple_Cran__Snack_Medley.png\",\"details\":{\"size\":630343,\"image\":{\"wid