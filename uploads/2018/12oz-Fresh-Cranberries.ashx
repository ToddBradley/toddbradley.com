nspray\",\"mikmak\":\"670032a57a1d7c0f07baae48\",\"bazaarVoice\":\"oceanspray\",\"curalate\":\"oceanspray-g0frjz\",\"bazaarVoiceSiteId\":\"main_site\",\"engineId\":\"j-As7u-eo3_Qc-Xhor-A\",\"gtm\":\"GTM-M7VQVSDN\",\"gtag\":\"G-CSHX9SKFN4\",\"gtmTest\":\"GTM-N8S9WFFH\",\"gtagTest\":\"G-LPKMNCGB2P\"}},{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"1IujG5SvWHeHfQvMpYPkrj\",\"type\":\"Entry\",\"createdAt\":\"2023-12-06T22:09:06.688Z\",\"updatedAt\":\"2024-11-08T09:10:19.229Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":34,\"revision\":13,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"country\"}},\"locale\":\"en-US\"},\"fields\":{\"name\":\"Canada\",\"tld\":\"ca\",\"countryCode\":\"CA\",\"languages\":[],\"legalHeading\":\"©[YEAR] Ocean Spray\",\"destini\":\"oceanspray\",\"mikmak\":\"672d13be02c77e0f0dcd5fb8\",\"bazaarVoice\":\"oceanspray\",\"curalate\":\"oceanspray\",\"bazaarVoiceSiteId\":\"main_site\"}}],\"title\":\"Mixers\",\"themeColor\":\"Cerulean Blue\",\"backgroundText\":\"Just a splash\",\"shortDescription\":\"The category landing page for mixers.\",\"featuredProducts\":[\"[Circular]\",{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"2lIK2MpjdFSOCFsWsJqFpO\",\"type\":\"Entry\",\"createdAt\":\"2024-02-13T13:24:06.513Z\",\"updatedAt\":\"2025-01-16T09:44:19.480Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":59,\"revision\":15,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"product\"}},\"locale\":\"en-US\"},\"fields\":{\"title\":\"Strawberry Margarita Cocktail Mixer\",\"slug\":\"strawberry-margarita-cocktail-mixer-32-oz\",\"hubSpotLabel\":\"Strawberry Margarita Cocktail Mixer\",\"description\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"A perfectly balanced mix of strawberry and lime flavors ready in seconds. Just add tequila to Ocean Spray® Strawberry Margarita Cocktail Mixer for a restaurant quality margarita at home. Made from real strawberry and lime fruit juice and less sugar than the leading mixer, this strawberry margarita mix strikes the right balance between sweet and tangy for beverages with vacation taste and at-home ease. Make a splash and impress guests with this margarita drink mixer; perfect for creating effortlessly excellent cocktails for big and small gatherings and special events. Whether you're stirring in your favorite tequila or trying something new, this margarita mixer makes a bold, refreshing beverage every time. Ocean Spray® also offers other delicious drink mixers for your favorite cocktails in seconds. We believe in uncommonly bold mashups.\",\"marks\":[],\"data\":{}}]}]},\"frontImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"2xBtkCbX9QLiLhM8InfsgQ\",\"type\":\"Asset\",\"createdAt\":\"2024-03-12T19:19:34.484Z\",\"updatedAt\":\"2024-03-12T19:19:34.484Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":2,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"Strawberry Margarita Cocktail Mixer\",\"description\":\"Strawberry Margarita Cocktail Mixer front image.\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b3/2xBtkCbX9QLiLhM8InfsgQ/c6583f70a7d85a60592ea94f7a13fc6e/Strawberry_Margarita_Cocktail_Mixer.png\",\"details\":{\"size\":378876,\"image\":{\"width\":1000,\"height\":1400}},\"fileName\":\"Strawberry Margarita Cocktail Mixer.png\",\"contentType\":\"image/png\"}}},\"gt