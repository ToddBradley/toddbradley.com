n\":\"Dive into Ocean Spray's Mango Cran Snack Medley, a pouch of juicy contradiction. Challenge your taste buds with our healthy Ocean Spray® Products.\",\"metaKeywords\":\"Craisins Dried Cranberries, Ocean Spray® Mango Cran™ Snack Medley\",\"ogTitle\":\"\",\"upc\":\"12094292-A369-4FA5-BFCB-42EE70D16EE8\",\"sitecoreId\":\"{12094292-A369-4FA5-BFCB-42EE70D16EE8}\",\"associatedRecipes\":[],\"disclaimer\":\"Made from real fruit\\r\\nNo artificial colors, flavors or preservatives\\r\\nNo high fructose corn syrup\\r\\nNo artificial sweeteners\\r\\n\"}},{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"1CFwoAVFNgZcGIMv4an7FZ\",\"type\":\"Entry\",\"createdAt\":\"2024-02-13T13:24:48.547Z\",\"updatedAt\":\"2025-01-17T16:12:29.945Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":65,\"revision\":16,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"product\"}},\"locale\":\"en-US\"},\"fields\":{\"title\":\"Greek Yogurt Flavored Dipped Cranberry Bites\",\"slug\":\"greek-yogurt-cranberry-bites-8-oz\",\"hubSpotLabel\":\"Greek Yogurt Flavored Dipped Cranberry Bites\",\"description\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Bold cranberry flavor. Smooth creamy coating. Ocean Spray® Greek Yogurt Covered Dried Cranberries. The cranberries you love with creamy Greek yogurt flavor. Enjoy the benefits of cranberry, even more. Real, bold dried cranberries dipped in a satisfying Greek yogurt flavored coating in every dried fruit pouch. Enjoy these little tangy treats as on the go snacks. Stash in your desk drawer. Share with friends and family. Or…don't. Stay in. Cozy up on that couch. Sprinkle over your favorite ice cream. And dig in. You and your taste buds deserve it. Step up your entertaining game by adding their bold flavor to apps, charcuterie boards and more. They're also just really good on their own.\",\"marks\":[],\"data\":{}}]}]},\"frontImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"39oCe7UJYHtOWtPhDAbCfX\",\"type\":\"Asset\",\"createdAt\":\"2024-11-01T10:10:00.482Z\",\"updatedAt\":\"2024-11-01T10:10:00.482Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":3,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"8oz OS Greek Yogurt Cran Bites front(00002 0000024453)(5837)\",\"description\":\"\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b3/39oCe7UJYHtOWtPhDAbCfX/dd11664558b09d7a1c5dd65e341c7aa1/8oz_OS_Greek_Yogurt_Cran_Bites_front_00002_0000024453__5837_.png\",\"details\":{\"size\":5857741,\"image\":{\"width\":3000,\"height\":3000}},\"fileName\":\"8oz_OS_Greek_Yogurt_Cran_Bites_front(00002_0000024453)(5837).png\",\"contentType\":\"image/png\"}}},\"gtin\":\"00031200037190\",\"size\":\"8 oz\",\"nutritionalInfoImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"1ut9lqZgpUZZRZuE91vDdR\",\"type\":\"Asset\",\"createdAt\":\"2024-09-10T18:33:21.087Z\",\"updatedAt\":\"2024-09-10T18:33:21.087Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":5,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"5oz OS Greek Yogurt Bites NFP(00002 0000015084)(4877) 1 Ingredients\",\"description\":\"Image for 5oz OS Greek Yogurt Bites NFP(00002 0000015084)(4877) 1 Ingredients\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b3/1ut9lqZgpUZZRZuE91vDdR/e75ce0e4a28fa7de770bb22418a7971e/5oz_Greek_Yogurt_Dipped_Cranberry_Bites_NutFacts.jpg\",\"details\":{\"size\":81407,\"ima