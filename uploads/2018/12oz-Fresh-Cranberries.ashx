"id\":\"fk5croonv4b3\"}},\"id\":\"48JWsEo6LLhMqeq8gvOykb\",\"type\":\"Entry\",\"createdAt\":\"2024-02-27T20:37:40.615Z\",\"updatedAt\":\"2025-01-14T21:22:54.156Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":213,\"revision\":14,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"moduleDialogCookies\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"[Default] Cookie Modal\",\"title\":\"Cookie Information\",\"heading\":\"We use cookies\",\"bodyText\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"We use cookies to collect information about you. We use this information:\u2028\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"},{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"to give you a better experience of our website (functional)\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"list-item\"},{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"to count the pages you visit (statistics)\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"list-item\"},{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"to serve you relevant promotions (marketing)\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"list-item\"}],\"nodeType\":\"ordered-list\"},{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Click “OK” to give us your consent to use cookies for all these purposes. You can also use the checkboxes to consent to specific purposes. Select purposes and “Save settings”.Withdraw or change your consent at any time by clicking the icon in the bottom left corner of the screen. Change your settings. Read more about how we use cookies and other technologies to collect personal data:\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"policyLinks\":[],\"declineLabel\":\"Decline All\",\"acceptLabel\":\"Accept\",\"detailsToggleLabelShow\":\"Show Details\",\"detailsToggleLabelHide\":\"Hide Details\",\"cookiesHeadingNecessary\":\"Strictly Necessary\",\"cookiesHeadingFunctional\":\"Functional\",\"cookiesHeadingStatistical\":\"Statistical\",\"cookiesHeadingMarketing\":\"Marketing\",\"cookiesHeadingUnclassified\":\"Unclassified\",\"cookiesTextNecessary\":\"Strictly necessary cookies help make a website navigable by activating basic functions such as page navigation and access to secure website areas. Without these cookies, the website would not be able to work properly.\",\"cookiesTextFunctional\":\"Functional cookies make it possible to save information that changes the way the website appears or acts. For instance your preferred language or region.\",\"cookiesTextStatistical\":\"Statistical cookies help the website owner understand how visitors interact with the website by collecting and reporting information.\",\"cookiesTextMarketing\":\"Marketing cookies are used to track visitors across websites. The intention is to display ads that are relevant and interesting to the individual user and thus more valuable for publishers and third-party advertisers.\",\"cookiesTextUnclassified\":\"We are in the process of classifying unclassified cookies together with the providers of the individual cookies.\"}},\"dictionary\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"28p2JqzwPvXsM3MBaWcpVI\",\"type\":\"Entry\",\"createdAt\":\"2023-12-06T22:07:14.426Z\",\"updatedAt\":\"2024-05-14T22:20:14.825Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":26,\"revision\":6,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"dictionary\"}},\"locale\":\"en-US\"},\"fields\":{\"name\":\"Glob