e\":\"Environment\"}},\"publishedVersion\":107,\"revision\":16,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"product\"}},\"locale\":\"en-US\"},\"fields\":{\"title\":\"Craisins® Dried Cranberries Cherry Juice Infused\",\"slug\":\"craisins-dried-cranberries-cherry-juice-infused-6-oz\",\"hubSpotLabel\":\"Craisins® Dried Cranberries Cherry Juice Infused\",\"description\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Big, bold, and bursting with cherry goodness. Ocean Spray® Cherry Flavored Craisins® Dried Cranberries combine the tart punch of dried cranberries with juicy cherry flavor for a snack that’s sweet, tangy, and totally crave-worthy. \",\"nodeType\":\"text\"},{\"data\":{},\"marks\":[],\"value\":\"Plus, 1 serving of Craisins® Dried Cranberries Cherry Juice Infused meets 25% of your daily recommended fruit needs. †Each ¼ cup serving Craisins® Dried Cranberries provides ½ cup of fruit.  The USDA My Plate recommends a daily intake of 2 cups of fruit for a 2,000 calorie diet. \",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"frontImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"9z7BGChoW0OXnHwQBSFTk\",\"type\":\"Asset\",\"createdAt\":\"2024-03-12T19:21:25.730Z\",\"updatedAt\":\"2025-05-07T14:44:33.583Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":6,\"revision\":2,\"locale\":\"en-US\"},\"fields\":{\"title\":\"Craisins® Dried Cranberries Cherry Juice Infused\",\"description\":\"Craisins® Dried Cranberries Cherry Juice Infused front image.\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b3/9z7BGChoW0OXnHwQBSFTk/92c4bc35a50ef77639020f40c626f34f/6oz_OS_Craisins_Cherry_front_00002_0000026009__7585__1.png\",\"details\":{\"size\":5088578,\"image\":{\"width\":3000,\"height\":3000}},\"fileName\