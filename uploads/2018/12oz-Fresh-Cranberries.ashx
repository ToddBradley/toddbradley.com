ocalPoint\":{\"x\":619,\"y\":410}}}}],\"featuredProducts\":[{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"1lDNMsvqn9lQOF2YxsH0R2\",\"type\":\"Entry\",\"createdAt\":\"2024-02-13T13:05:59.956Z\",\"updatedAt\":\"2025-10-22T15:33:09.383Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":365,\"revision\":23,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"product\"}},\"locale\":\"en-US\"},\"fields\":{\"title\":\"The Original Cranberry Juice Cocktail\",\"metaTitle\":\"Nutritious Ocean Spray® Original Cranberry Juice Cocktail\",\"metaDescription\":\"Get ready for our Ocean Spray® Cranberry Juice Cocktail, a love letter to nutritious juices. This isn't your average fruit juice product—it's a healthy dose of flavor.\",\"metaKeywords\":\"cranberry juice, cranberry juice blends\",\"backgroundColor\":\"Bright Red\",\"countries\":[{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"4YhS9Pyt2s9lYDTnbwU7cg\",\"type\":\"Entry\",\"createdAt\":\"2023-12-06T22:07:30.385Z\",\"updatedAt\":\"2024-10-24T10:00:24.527Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":105,\"revision\":39,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"country\"}},\"locale\":\"en-US\"},\"fields\":{\"name\":\"United States\",\"tld\":\"com\",\"countryCode\":\"US\",\"languages\":[],\"headerMenus\":[],\"footerMenus\":[],\"newsletterHeading\":\"In Cran We Trust\",\"newsletterText\":\"Wave your cran flag high. Join now and get access to exclusive offers, the latest news from the bog, and new product sneak peeks.\",\"newsletterTermsConditionsText\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim\\n\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"legalHeading\":\"©2024 Ocean Spray\",\"destini\":\"oceanspray\",\"mikmak\":\"670032a57a1d7c0f07baae48\",\"bazaarVoice\":\"oceanspray\",\"curalate\":\"oceanspray-g0frjz\",\"bazaarVoiceSiteId\":\"main_site\",\"engineId\":\"j-As7u-eo3_Qc-Xhor-A\",\"gtm\":\"GTM-M7VQVSDN\",\"gtag\":\"G-CSHX9SKFN4\",\"gtmTest\":\"GTM-N8S9WFFH\",\"gtagTest\":\"G-LPKMNCGB2P\"}}],\"gtin\":\"00031200200075\",\"slug\":\"cranberry-juice-cocktail-64-oz\",\"frontImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"7eJjV4XFIn6vua5J7prv5y\",\"type\":\"Asset\",\"createdAt\":\"2024-04-11T15:20:29.278Z\",\"updatedAt\":\"2024-04-11T15:20:29.278Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":2,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"64oz OS Cranberry front v2\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b3/7eJjV4XFIn6vua5J7prv5y/6e26af9458c2e0024bc94f40cbb56e96/64oz_OS_Cranberry_front_v2.png\",\"details\":{\"size\":192536,\"image\":{\"width\":500,\"height\":500}},\"fileName\":\"64oz_OS_Cranberry_front_v2.png\",\"contentType\":\"image/png\"}}},\"description\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Crisp. Experience the insane deliciousness of Ocean Spray® Cranberry Juice Cocktail. The trailblazing juice drink made with bold cranberry fruit juice concentrate. This fruit juice beverage packs 100% of your recommended daily value of vitamin C in a single serving. No high fructose corn syrup. This beverage has only the good stuff. Use this cranberry juice drink as a cocktail mixer for radically refreshing drinks. Serve it over ice with a splash of vodka for a tangy cranberry cocktail. Or change up dinner with some cranberry drunken chicken or cranberry cocktail meatballs. Original Cranberry Juice Cocktail makes a delicious, unique addition to blended beverages and ice pops, too. Get creative. Go bog-wild. All this made possible by the 700+ cranberry family farmers that make up our co-op. Our owners. Our heartbeat. Our inspiration. Ocean Spray believes in the power of the mighty cranberry; Born Tart. Raised Bold.™\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"size\":\"64 oz\",\"nutritionalInfoImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"12cCVmDiPdx071GcPQV4SZ\",\"type\":\"Asset\",\"createdAt\":\"2024-09-06T18:35:17.627Z\",\"updatedAt\":\"2025-08-18T12:00:36.999Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":12,\"revision\":2,\"locale\":\"en-US\"},\"fields\":{\"title\":\"64oz OS Cranberry NFP(00002 0000018595)(5328) 1 Ingredients\",\"description\":\"Image for 64oz OS Cranberry NFP(00002 0000018595)(5328) 1 Ingredients\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b3/12cCVmDiPdx071GcPQV4SZ/e9284b14ea7ce51813ec19c231983432/64oz_OS_Cranberry_Juice_Cocktail_NutFacts.png\",\"details\":{\"size\":538651,\"image\":{\"width\":3000,\"height\":3000}},\"fileName\":\"64oz_OS_Cranberry_Juice_Cocktail_NutFacts.png\",\"contentType\":\"image/png\"}}},\"nutritionalFacts\":[{\"id\":\"8c9d2b47-61a1-4391-9dfd-c411938122eb\",\"key\":\"No High Fructose Corn Syrup\",\"value\":\"\"},{\"id\":\"b6f07300-eec9-4069-8bff-dccf0a6a5fa6\",\"key\":\"100% Vitamin C\",\"value\":\"100% Daily Value of Vitamin C per 8 FL OZ serving\"},{\"id\":\"1e7a31b9-c2dd-4cf4-a624-03582dc905bb\",\"key\":\"Consuming one serving (8 oz) each day of a cranberry juice beverage may help reduce the risk of recurrent urinary tract infection (UTI) in healthy women. FDA has concluded that the scientific evidence supporting this claim is limited and inconsistent.\",\"value\":\"\"}],\"disclaimer\":\"100% Vitamin C \\r\\n\\r\\n100% Daily Value of Vitamin C per 8 FL OZ serving  \",\"category\":{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"fr\"}},{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"mwQK5Qykqzzddl68NqdEF\",\"type\":\"Entry\",\"createdAt\":\"2023-12-07T17:14:28.456Z\",\"updatedAt\":\"2025-05-01T16:37:21.301Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":1150,\"revision\":14,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"productCategory\"}},\"locale\":\"en-US\"},\"fields\":{\"slug\":\"juices\",\"name\":\"Juices \u0026 Juice Drinks\",\"countries\":[{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"4YhS9Pyt2s9lYDTnbwU7cg\",\"type\":\"Entry\",\"createdAt\":\"2023-12-06T22:07:30.385Z\",\"updatedAt\":\"2024-10-24T10:00:24.527Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":105,\"revision\":39,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"country\"}},\"locale\":\"en-US\"},\"fields\":{\"name\":\"United States\",\"tld\":\"com\",\"countryCode\":\"US\",\"languages\":[],\"headerMenus\":[],\"footerMenus\":[],\"newsletterHeading\":\"In Cran We Trust\",\"newsletterText\":\"Wave your cran flag high. Join now and get access to exclusive offers, the latest news from the bog, and new product sneak peeks.\",\"newsletterTermsConditionsText\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim\\n\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"legalHeading\":\"©2024 Ocean Spray\",\"destini\":\"oceanspray\",\"mikmak\":\"670032a57a1d7c0f07baae48\",\"bazaarVoice\":\"oceanspray\",\"curalate\":\"oceanspray-g0frjz\",\"bazaarVoiceSiteId\":\"main_site\",\"engineId\":\"j-As7u-eo3_Qc-Xhor-A\",\"gtm\":\"GTM-M7VQVSDN\",\"gtag\":\"G-CSHX9SKFN4\",\"gtmTest\":\"GTM-N8S9WFFH\",\"gtagTest\":\"G-LPKMNCGB2P\"}},{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"1IujG5SvWHeHfQvMpYPkrj\",\"type\":\"Entry\",\"createdAt\":\"2023-12-06T22:09:06.688Z\",\"updatedAt\":\"2024-11-08T09:10:19.229Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":34,\"revision\":13,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"country\"}},\"locale\":\"en-US\"},\"fields\":{\"name\":\"Canada\",\"tld\":\"ca\",\"countryCode\":\"CA\",\"languages\":[],\"legalHeading\":\"©[YEAR] Ocean Spray\",\"destini\":\"oceanspray\",\"mikmak\":\"672d13be02c77e0f0dcd5fb8\",\"bazaarVoice\":\"oceanspray\",\"curalate\":\"oceanspray\",\"bazaarVoiceSiteId\":\"main_site\"}}],\"title\":\"Juices \u0026 Juice Drinks\",\"themeColor\":\"Red\",\"backgroundText\":\"Wild \u0026 Fresh\",\"shortDescription\":\"The category landing page for juices.\",\"featuredProducts\":[\"[Circular]\"]}},\"typeFilters\":[],\"benefitFilters\":[],\"hubSpotLabel\":\"The Original Cranberry Juice Cocktail\",\"dietaryFilters\":[],\"flavorFilters\":[],\"associatedRecipes\":[],\"destiniAssociationId\":\"CranberryJuiceCocktail64oz\",\"bvProductId\":\"CFBD1F39-554B-4E79-BB0D-85F7EC5496DD\",\"curalateProductId\":\"CFBD1F39-554B-4E79-BB0D-85F7EC5496DD-64 oz\",\"ogTitle\":\"Ocean Spray® Cranberry Juice Cocktail\",\"upc\":\"CFBD1F39-554B-4E79-BB0D-85F7EC5496DD\",\"sitecoreId\":\"{EB1538BA-F2FE-4476-B0BC-2C0D16D6EA46}\"}},{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"593p2gLhUmMowZN5ClKZ9L\",\"type\":\"Entry\",\"createdAt\":\"2024-02-13T13:05:52.277Z\",\"updatedAt\":\"2025-01-16T09:58:38.948Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":220,\"revision\":18,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"product\"}},\"locale\":\"en-US\"},\"fields\":{\"title\":\"Cran x Tropical™\",\"slug\":\"cran-tropical-cranberry-tropical-juice-drink-64-oz\",\"hubSpotLabel\":\"Cran x Tropical™\",\"description\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Radically refreshing. Unapologetically bold. Ocean Spray® Cran-Tropical™ Cranberry Tropical Juice Drink has a fresh, zingy taste to quench the strongest thirst. The tropical flavors of mango, guava and orange with the crisp, tart taste of cranberries make this tropical cranberry juice beverage a bucket list item all on its own. With 100% of your recommended daily value of vitamin C and no high fructose corn syrup, this tropical drink is a full punch of flavor without compromise. Made from real fruit juice concentrate, it's low sodium and fat-free. Stir Cran-Tropical™ into your favorite drinks as a cocktail mixer, freeze into ice pops, or enjoy straight from the bottle. We won't judge. All this made possible by the 700+ cranberry farming families that make up our co-op. Our owners. Our heartbeat. Our inspiration. Ocean Spray believes in the power of the mighty cranberry; Born Tart. Raised Bold.™\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"frontImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"53WDa5yNanoGVkgMrn7nG2\",\"type\":\"Asset\",\"createdAt\":\"2024-04-10T21:53:27.225Z\",\"updatedAt\":\"2024-04-10T21:53:27.225Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":2,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"64oz OS CranTropical front v2\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b3/53WDa5yNanoGVkgMrn7nG2/83fc295204db4b85e82a83719fd50682/64oz_OS_CranTropical_front_v2.png\",\"details\":{\"size\":185061,\"image\":{\"width\":500,\"height\":500}},\"fileName\":\"64oz_OS_CranTropical_front_v2.png\",\"contentType\":\"image/png\"}}},\"gtin\":\"00031200026705\",\"size\":\"64 oz\",\"nutritionalInfoImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"1cSmEDhHApdTdpZdBmZTsz\",\"type\":\"Asset\",\"createdAt\":\"2024-09-10T18:31:49.560Z\",\"updatedAt\":\"2024-09-10T18:31:49.560Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":7,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"2019 OS 25oz CranTropical Nutrition Facts 1 Images\",\"description\":\"Image for 2019 OS 25oz CranTropical Nutrition Facts 1 Ingredients\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b3/1cSmEDhHApdTdpZdBmZTsz/61a308ac3741990ede5958acbfe42d7e/64oz_CranTropical_Nutri_facts.jpg\",\"details\":{\"size\":272777,\"image\":{\"width\":366,\"height\":860}},\"fileName\":\"64oz_CranTropical_Nutri_facts.jpg\",\"contentType\":\"image/jpeg\"}}},\"nutritionalFacts\":[{\"id\":\"e27099cf-5be8-4cdd-b73c-f7a5351792ca\",\"key\":\"80 Calories Per 8 FL OZ Serving\",\