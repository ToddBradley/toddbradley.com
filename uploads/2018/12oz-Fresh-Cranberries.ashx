d\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":11,\"revision\":2,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"country\"}},\"locale\":\"en-US\"},\"fields\":{\"name\":\"Chile\",\"tld\":\"cl\",\"countryCode\":\"CL\",\"languages\":[],\"headerMenus\":[],\"footerMenus\":[],\"newsletterHeading\":\"In Cran We Trust\",\"newsletterText\":\"Wave your cran flag high. Join now and get access to exclusive offers, the latest news from the bog, and new product sneak peeks.\",\"newsletterTermsConditionsText\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim\\n\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"legalHeading\":\"©2024 Ocean Spray\",\"destini\":\"oceanspray\",\"bazaarVoice\":\"oceanspray\",\"curalate\":\"oceanspray-g0frjz\",\"bazaarVoiceSiteId\":\"main_site\",\"engineId\":\"j-As7u-eo3_Qc-Xhor-A\",\"gtm\":\"GTM-M7VQVSDN\",\"gtag\":\"G-CSHX9SKFN4\",\"gtmTest\":\"GTM-N8S9WFFH\",\"gtagTest\":\"G-LPKMNCGB2P\"}}],\"slug\":\"the-mighty-cranberry\",\"title\":\"The Mighty Cranberry\",\"description\":\"Page description for the The Mighty Cranberry Landing Page.\",\"backgroundColor\":\"Red\",\"heroModule\":{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"5ML2rSNCCeFXr8ybU579eX\",\"type\":\"Entry\",\"createdAt\":\"2024-03-14T19:31:00.085Z\",\"updatedAt\":\"2024-08-04T21:10:26.794Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":238,\"revision\":15,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"moduleHeroStory\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"The Mighty Cran\",\"variant\":\"The Mighty Cran\",\"headingLine1\":\"The\",\"headingLine2\":\"Mighty\",\"headingLine3\":\"Cran\"}},\"modules\":[{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"5VhyfJohuSumIKnzJoHkDL\",\"type\":\"Entry\",\"createdAt\":\"2024-03-05T21:56:14.070Z\",\"updatedAt\":\"2024-08-07T20:00:59.777Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":226,\"revision\":4,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"textModule\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"The Mighty Cran - Large Statement\",\"variant\":\"Large Statement\",\"bodyText\":\"It’s one of the superest of superfruits. With a taste that can’t be imagined. Farmed by mavericks. Enjoyed by the bold. Pucker up, cran fans. This little berry is full of surprises.\",\"stickerLabels\":[\"Berry\",\"Bog\",\"Bold\",\"Bitter\"]}},{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"6jaPQl4iM1zzD3tTvgtDg2\",\"type\":\"Entry\",\"createdAt\":\"2024-02-29T01:31:09.864Z\",\"updatedAt\":\"2024-11-20T14:11:09.540Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":256,\"revision\":5,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"textAndImageModule\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"Layered Evergreen - Text Top\",\"variant\":\"Layered Evergreen - Text Top\",\"backgroundColor\":\"Red\",\"heading\":\"Born in the Bogs of North America\",\"bodyText\":\"From Northeast. To Northwest. To the wetlands in between. These sun-kissed berries are one of three OG fruits from North America. You’ll find them on long-running vines in bogs (that’s just spongy,\u2028soft-soiled ground).\",\"accentText\":\"the mighty cran\"}},{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"1hejDAJf1RpTa2FQoeWx6R\",\"type\":\"Entry\",\"createdAt\":\"2024-03-06T17:18:52.356Z\",\"updatedAt\":\"2024-08-07T20:01:14.645Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":229,\"revision\":9,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"textAndImageModule\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"Editorial Text Left: Raised Rough\",\"variant\":\"50/50 Editorial - Text Left\",\"backgroundColor\":\"Red\",\"heading\":\"Raised Rough\",\"bodyText\":\"Cranberries are stubborn. But in a good way. They live for the moist soil of bogs and marshes. Dig harsh winters. Unlike their other precious fruit friends. And they love a bit of sunshine when they can get it.\"}},{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"2tfnMWqTFTkjElF5nWuGeC\",\"type\":\"Entry\",\"createdAt\":\"2024-03-06T17:26:29.788Z\",\"updatedAt\":\"2025-07-02T10:05:02.504Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":277,\"revision\":11,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"textAndImageModule\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"Centered Evergreen: Harvest\",\"variant\":\"Centered Evergreen\",\"backgroundColor\":\"Red\",\"heading\":\"And then we harvest\",\"bodyText\":\"Two ways to do it. The first is dry harvest. Basically, a giant lawnmower combs the crimson berries from their vine. The other is wet harvest. Where we churn the bog water with the biggest “egg beaters” imaginable. The ripe berries rise to the surface. Thanks to tiny air pockets inside.\",\"illustration\":true,\"selectIllustration\":\"Juice Bottle\"}},{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"4zPWWRL3zyym3ALKHA56N6\",\"type\":\"Entry\",\"createdAt\":\"2024-02-13T16:56:12.938Z\",\"updatedAt\":\"2024-08-07T20:01:33.852Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":219,\"revision\":4,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"moduleContentStoryTelling\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"Content: List\",\"variant\":\"List\",\"backgroundColor\":\"Red\",\"heading\":\"Cran Tasting\",\"cards\":[]}},{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"18PobGshDNykSOMXEdVb5H\",\"type\":\"Entry\",\"createdAt\":\"2024-03-05T21:58:45.329Z\",\"updatedAt\":\"2024-08-07T20:01:39.791Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":220,\"revision\":3,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"textModule\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"The Mighty Cran - Quote\",\"variant\":\"Quote\",\"backgroundColor\":\"Red\",\"bodyText\":\"“Cranberries are a unique and special crop.  The beauty of the harvest, the connection with family, and the relationships within the grower community make it a rewarding way of life.”\",\"attribution\":\"Shawn Cutts, Farmer-Owner\"}},{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"5yvkx4H6dPeixXoBtHwIxe\",\"type\":\"Entry\",\"createdAt\":\"2024-03-05T21:40:46.989Z\",\"updatedAt\":\"2024-08-07T20:01:46.862Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":226,\"revision\":4,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"textModule\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"History - Large Statement\",\"variant\":\"Headline\",\"backgroundColor\":\"Dark Red\",\"heading\":\"A history as rich as its flavor\"}},{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"54Zn2nKB8dwbWvlcfSsjoe\",\"type\":\"Entry\",\"createdAt\":\"2024-02-14T20:11:46.349Z\",\"updatedAt\":\"2024-08-28T14:25:54.408Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":227,\"revision\":6,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"moduleContentStoryTelling\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"Content: Carousel\",\"variant\":\"Carousel\",\"backgroundText\":\"History of the cran\",\"heading\":\"Did you know?\",\"cards\":[]}},{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"51ogtbka53Nv4Q8Z9pbp3P\",\"type\":\"Entry\",\"createdAt\":\"2024-03-07T16:45:42.082Z\",\"updatedAt\":\"2025-07-02T10:10:35.650Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":252,\"revision\":4,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"moduleRoutingMixedUseFlexibleCards\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"Flexible Cards: The Cran's Early Uses\",\"variant\":\"Flexible Cards\",\"backgroundColor\":\"Dark Red\",\"illustration\":true,\"selectIllustration\":\"Leaf\",\"heading\":\"The Cran's Early Uses\",\"cards\":[]}},{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"6dYjF2NKd85REjjZkXMMPc\",\"type\":\"Entry\",\"createdAt\":\"2024-03-07T16:49:49.626Z\",\"updatedAt\":\"2024-11-20T14:13:57.644Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":249,\"revision\":4,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"textAndImageModule\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"Layered Evergreen - Text Right: The OG Party Favor\",\"variant\":\"Layered Evergreen - Text Right\",\"backgroundColor\":\"Dark Red\",\"heading\":\"The OG Party Favor\",\"bodyText\":\"Cranberries have been at it for a while - making plates suck a little less from the beginning. Even a cookbook from 1663 mentioned one of the first recipes for cran sauce. Then we made it history by canning it in 1930.\",\"accentText\":\"TRUSTED IN THE WILD\"}},{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"2BaPM1dQJdPRIyndA9eQ9Q\",\"type\":\"Entry\",\"createdAt\":\"2024-03-05T22:01:33.461Z\",\"updatedAt\":\"2025-02-28T09:46:05.095Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":249,\"revision\":3,\"contentType\":{\