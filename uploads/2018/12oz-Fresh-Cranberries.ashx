im\\n\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"legalHeading\":\"©2024 Ocean Spray\",\"destini\":\"oceanspray\",\"bazaarVoice\":\"oceanspray\",\"curalate\":\"oceanspray-g0frjz\",\"bazaarVoiceSiteId\":\"main_site\",\"engineId\":\"j-As7u-eo3_Qc-Xhor-A\",\"gtm\":\"GTM-M7VQVSDN\",\"gtag\":\"G-CSHX9SKFN4\",\"gtmTest\":\"GTM-N8S9WFFH\",\"gtagTest\":\"G-LPKMNCGB2P\"}}],\"slug\":\"about-us\",\"title\":\"About Us\",\"description\":\"Page description for the About Us Landing Page.\",\"heroModule\":{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"013iKhe57t6ffwy1B9NzqS\",\"type\":\"Entry\",\"createdAt\":\"2024-03-29T14:40:54.134Z\",\"updatedAt\":\"2024-08-14T16:40:18.463Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":203,\"revision\":6,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"moduleHeroLandingPages\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"About Us Hero\",\"variant\":\"Landing Hero\",\"illustration\":\"Can\",\"heading\":\"Super-Fruit Super Fans\",\"backgroundText\":\"Cran Love\"}},\"modules\":[{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"4agtI6f1JLp3mqe9Hf7u02\",\"type\":\"Entry\",\"createdAt\":\"2024-03-05T19:37:08.801Z\",\"updatedAt\":\"2025-10-23T07:17:44.042Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":245,\"revision\":8,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"textModule\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"About Us Large Statement\",\"variant\":\"Long Copy\",\"backgroundColor\":\"Off White\",\"bodyText\":\"It takes a certain spirit to grow this berry into the super-fruit powerhouse it can be.\\n\\nOcean Spray was built on the maverick mindset of three bold farmers. Today, we’re a vibrant agricultural cooperative of around 700 family farmers. \\n\\nA unique little fruit. A rich history. The cranberry might be a little offbeat. With its bold, bitter taste, the cranberry might be a little offbeat. But then, so are we.\"}},{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"3GIYawoJzvI6ZGchYIszp0\",\"type\":\"Entry\",\"createdAt\":\"2024-03-29T17:47:00.370Z\",\"updatedAt\":\"2024-08-07T19:52:02.960Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":195,\"revision\":4,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"textAndImageModule\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"50/50 Editorial: Bold Beginnings\",\"variant\":\"50/50 Editorial - Text Left\",\"backgroundColor\":\"Red\",\"heading\":\"Bold Beginnings\",\"bodyText\":\"Deliciously innovative since 1930. Three passionate, independent cranberry growers banded together with one mission: see this superfruit soar. 700+ farmers later, the Ocean Spray Cooperative has far outgrown its tiny but mighty beginnings.\"}},{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"2E1pBvybqbBTRMBjYOZ1SA\",\"type\":\"Entry\",\"createdAt\":\"2024-03-14T20:56:39.362Z\",\"updatedAt\":\"2024-08-07T19:53:18.494Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":12,\"revision\":4,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"moduleTextAndImageTimeline\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"[Text+Image] - Timeline\",\"variant\":\"Timeline\",\"timelineCards\":[]}},{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"32QlQCmgRwpGsuEezM7pCV\",\"type\":\"Entry\",\"createdAt\":\"2024-03-29T17:52:28.207Z\",\"updatedAt\":\"2025-07-02T10:10:35.514Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":229,\"revision\":4,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"moduleRoutingMixedUseFlexibleCards\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"Flexible Cards: Bold Beginnings\",\"variant\":\"Flexible Cards\",\"backgroundColor\":\"Maroon\",\"illustration\":true,\"selectIllustration\":\"Turtle\",\"heading\":\"Our Farmer Owners\",\"cards\":[]}},{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"31u4Il8IXHAnSfxctkSx2S\",\"type\":\"Entry\",\"createdAt\":\"2024-03-29T17:55:16.429Z\",\"updatedAt\":\"2025-10-23T07:13:52.470Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":234,\"revision\":6,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"textAndImageModule\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"50/50 Impact: The Mighty Cranberry\",\"variant\":\"50/50 Impact - Text Left\",\"backgroundColor\":\"Off White\",\"heading\":\"The Mighty Cranberry\",\"bodyText\":\"Cranberries are packed with antioxidants and prebiotics to fuel the good within. And there’s more to uncover. The super potential within this bold, little berry. \",\"stamp\":false,\"illustration\":true,\"selectIllustration\":\"Cranberries (Single)\"}},{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"3OPnBHBS88Vqh2cTGoPm81\",\"type\":\"Entry\",\"createdAt\":\"2024-03-29T17:57:25.392Z\",\"updatedAt\":\"2025-10-23T07:13:51.455Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":255,\"revision\":18,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"textAndImageModule\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"50/50 Impact: Bold flavor takes time\",\"variant\":\"50/50 Impact - Text Right\",\"backgroundColor\":\"Off White\",\"heading\":\"Bold flavor takes time\",\"bodyText\":\"The cranberry harvest. A year’s worth of hard work, culminating in an incredible process. Come autumn, cranberries finally reach their peak. Crimson color. Bright flavor. A moment Ocean Spray growers are always proud of.\",\"stamp\":true,\"illustration\":false,\"selectStamp\":\"Dried and True\"}},{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"4GJ8uO2IzCpRhMzw9wuHX\",\"type\":\"Entry\",\"createdAt\":\"2024-03-29T16:51:18.576Z\",\"updatedAt\":\"2024-08-28T16:27:34.391Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":211,\"revision\":4,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"moduleRoutingMixedUseFlexibleText\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"About Us: Craving more?\",\"variant\":\"Flexible Text\",\"heading\":\"Craving more?\"}}]}},\"openInNewWindow\":false,\"dow