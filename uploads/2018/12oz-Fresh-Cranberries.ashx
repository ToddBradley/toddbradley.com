":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"country\"}},\"locale\":\"en-US\"},\"fields\":{\"name\":\"U.S. Virgin Islands\",\"tld\":\"com.vi\",\"countryCode\":\"VI\",\"languages\":[],\"headerMenus\":[],\"footerMenus\":[],\"newsletterHeading\":\"In Cran We Trust\",\"newsletterText\":\"Wave your cran flag high. Join now and get access to exclusive offers, the latest news from the bog, and new product sneak peeks.\",\"newsletterTermsConditionsText\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim\\n\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"legalHeading\":\"©2024 Ocean Spray\",\"destini\":\"oceanspray\",\"bazaarVoice\":\"oceanspray\",\"curalate\":\"oceanspray-g0frjz\",\"bazaarVoiceSiteId\":\"main_site\",\"engineId\":\"j-As7u-eo3_Qc-Xhor-A\",\"gtm\":\"GTM-M7VQVSDN\",\"gtag\":\"G-CSHX9SKFN4\",\"gtmTest\":\"GTM-N8S9WFFH\",\"gtagTest\":\"G-LPKMNCGB2P\"}}],\"slug\":\"the-harvest\",\"title\":\"The Harvest | Our Farmers\",\"description\":\"Page description for the The Harvest Sub-Page.\",\"backgroundColor\":\"Navy\",\"heroModule\":{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"72iuplapQSprHfk2AOZCcc\",\"type\":\"Entry\",\"createdAt\":\"2024-03-13T22:39:18.618Z\",\"updatedAt\":\"2024-08-07T21:44:35.430Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":192,\"revision\":5,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"moduleHeroStory\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"About The Harvest\",\"variant\":\"About the Harvest\",\"backgroundColor\":\"Cerulean Blue\",\"headingLine1\":\"About\",\"headingLine2\":\"The\",\"headingLine3\":\"Harvest\"}},\"modules\":[{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"7w7Qzb54F4M3BFB5gZtEBF\",\"type\":\"Entry\",\"createdAt\":\"2024-03-14T18:23:10.607Z\",\"updatedAt\":\"2024-08-07T19:59:06.678Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":187,\"revision\":3,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"textModule\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"Large Statement: The Harvest\",\"variant\":\"Large Statement\",\"bodyText\":\"Every autumn cranberries reach their peak of color and flavor and are ready for harvesting. That's when our growers harvest millions of pounds of cranberries. \"}},{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"Bll24ICMT1IHFL6CZVGWy\",\"type\":\"Entry\",\"createdAt\":\"2024-03-28T19:26:57.541Z\",\"updatedAt\":\"2025-07-02T10:06:04.898Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":224,\"revision\":4,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"textAndImageModule\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"50/50 Editorial: Fall Is Harvest Season\",\"variant\":\"50/50 Editorial - Text Left\",\"heading\":\"Fall Is Harvest Season\",\"bodyText\":\"Every autumn (usually from mid-September until around mid-November in North America and March through May in Chile), cranberries reach their peak of color and flavor and are ready for harvesting. That's when our growers harvest millions of pounds of cranberries. If you ask us, it's really quite beautiful.\",\"stamp\":false,\"illustration\":true,\"selectIllustration\":\"Juice Bottle\"}},{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"1IPqoBTqHH28UO043W4fjF\",\"type\":\"Entry\",\"createdAt\":\"2024-03-28T19:35:55.176Z\",\"updatedAt\":\"2025-10-23T07:13:52.375Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":231,\"revision\":6,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"textAndImageModule\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"50/50 Impact: Wet Harvest\",\"variant\":\"50/50 Impact - Text Left\",\"heading\":\"Wet Harvest\",\"bodyText\":\"A lot of people think that cranberries grow under water. Makes sense, since we usually see the berries floating on top of the water. But, what we’re seeing is actually the result of wet harvesting. The bog is flooded with up to 18 inches of water the night before the berries are to be harvested. \\n\\nThe growers then use unique harvesting machines to churn the water and loosen the cranberries from the vine. Each berry has tiny pockets of air that allow it to float to the surface of the water.\\n\\nFrom there, they’re corralled together, loaded into trucks, and shipped off to become the Ocean Spray® products that fill your grocery aisles.\",\"stamp\":false,\"illustration\":true,\"selectIllustration\":\"Cranberries (Single)\"}},{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"2DuyrIZG4QhEoaZGnvu8XE\",\"type\":\"Entry\",\"createdAt\":\"2024-03-28T19:38:36.149Z\",\"updatedAt\":\"2025-10-23T07:13:51.502Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":240,\"revision\":8,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"textAndImageModule\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"50/50 Impact: Dry Harvest - Fresh Cranberries\",\"variant\":\"50/50 Impact - Text Right\",\"backgroundColor\":\"Navy\",\"heading\":\"Fresh Cranberries\",\"bodyText\":\"Fresh cranberries, the ones you buy in the produce aisle every fall, are harvested through one of two ways. Either dry picked or water harvested by gently combing the berries off the vines and drying them to make sure they are the highest quality fruit.\",\"stamp\":true,\"illustration\":false,\"selectStamp\":\"In Cran We Trust\"}},{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"5K6qhq7AZ4NoA2AQLj1pM2\",\"type\":\"Entry\",\"createdAt\":\"2024-03-28T19:49:27.513Z\",\"updatedAt\":\"2024-08-07T19:59:40.172Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":195,\"revision\":4,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"ugcModule\"}},\"locale\":\"en-US\"},\"fields\":{\"internalName\":\"About The Harvest: UGC Carousel\",\"variant\":\"Custom UGC\",\"backgroundColor\":\"Navy\",\"heading\":\"#oceansprayharvest\",\"bodyText\":\"Here’s a sneak peek straight from the bog of the magic behind the most beautiful harvest – Ocean Spray’s cranberry harvest. Tag @OceanSprayInc for your content to be featured!\",\"accentText\":\"the harvest\",\"images\":[]}},{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"mx\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"5E6DnHPvcMQxfPCAXkrxgI\",\"type\":\"Entry\",\