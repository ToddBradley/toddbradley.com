\"}},\"publishedVersion\":34,\"revision\":13,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"country\"}},\"locale\":\"en-US\"},\"fields\":{\"name\":\"Canada\",\"tld\":\"ca\",\"countryCode\":\"CA\",\"languages\":[],\"legalHeading\":\"©[YEAR] Ocean Spray\",\"destini\":\"oceanspray\",\"mikmak\":\"672d13be02c77e0f0dcd5fb8\",\"bazaarVoice\":\"oceanspray\",\"curalate\":\"oceanspray\",\"bazaarVoiceSiteId\":\"main_site\"}}],\"title\":\"Mixers\",\"themeColor\":\"Cerulean Blue\",\"backgroundText\":\"Just a splash\",\"shortDescription\":\"The category landing page for mixers.\",\"featuredProducts\":[{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"10ojtDytVETiYWsmJLgKnY\",\"type\":\"Entry\",\"createdAt\":\"2024-02-13T13:23:52.809Z\",\"updatedAt\":\"2025-01-16T09:46:18.884Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":74,\"revision\":17,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"product\"}},\"locale\":\"en-US\"},\"fields\":{\"title\":\"Cosmo Cocktail Mixer\",\"slug\":\"cosmopolitan-cocktail-mixer-32-oz\",\"hubSpotLabel\":\"Cosmo Cocktail Mixer\",\"description\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"A perfectly balanced mix of cranberry and lime flavors ready in seconds. Just add vodka to Ocean Spray® Cosmopolitan Cocktail Mixer for a restaurant quality cosmo at home. Made from real cranberry and lime fruit juice and less sugar than the leading mixer, this cosmopolitan mix strikes the right balance between sweet and tart for beverages with big city taste and at-home ease. Make a splash and impress guests with this cosmopolitan drink mixer; perfect for creating effortlessly excellent cocktails for big and small gatherings and special events. Whether you're stirring in your favorite vodka or trying something new, this drink mix makes a bright, refreshing beverage every time. Ocean Spray® also offers other delicious drink mixers for your favorite cocktails in seconds. We believe in uncommonly bold mashups.\",\"marks\":[],\"data\":{}}]}]},\"frontImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"69CIX3z4uytR95Kd15EHWu\",\"type\":\"Asset\",\"createdAt\":\"2024-03-12T19:14:22.548Z\",\"updatedAt\":\"2024-03-12T19:14:22.548Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":2,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"Cosmopolitan Cocktail Mixer\",\"description\":\"Cosmopolitan Cocktail Mixer front image.\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b3/69CIX3z4uytR95Kd15EHWu/6cfb5a849acfd371314f0b3c47ad4528/Cosmopolitan_Cocktail_Mixer.png\",\"details\":{\"size\":360945,\"image\":{\"width\":1000,\"height\":1400}},\"fileName\":\"Cosmopolitan Cocktail Mixer.png\",\"contentType\":\"image/png\"}}},\"gtin\":\"00031200022691\",\"size\":\"32 oz\",\"nutritionalInfoImage\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"6idVTbDBAkMootL2xNMKtD\",\"type\":\"Asset\",\"createdAt\":\"2024-09-10T19:02:39.202Z\",\"updatedAt\":\"2024-09-10T19:02:39.202Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":5,\"revision\":1,\"locale\":\"en-US\"},\"fields\":{\"title\":\"32oz OS Cosmo Mixer NFP(00002 0000016702)(5152) 1 Ingredients\",\"description\":\"Image for 32oz OS Cosmo Mixer NFP(00002 0000016702)(5152) 1\",\"file\":{\"url\":\"/ctf/img/fk5croonv4b3/6idVTbDBAkMootL2xNMKtD/cac082bee641a01a05e00d6645e04652/Cosmopolitan_Co