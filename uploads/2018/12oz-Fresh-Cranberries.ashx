ookiesHeadingMarketing\":\"Marketing\",\"cookiesHeadingUnclassified\":\"Unclassified\",\"cookiesTextNecessary\":\"Strictly necessary cookies help make a website navigable by activating basic functions such as page navigation and access to secure website areas. Without these cookies, the website would not be able to work properly.\",\"cookiesTextFunctional\":\"Functional cookies make it possible to save information that changes the way the website appears or acts. For instance your preferred language or region.\",\"cookiesTextStatistical\":\"Statistical cookies help the website owner understand how visitors interact with the website by collecting and reporting information.\",\"cookiesTextMarketing\":\"Marketing cookies are used to track visitors across websites. The intention is to display ads that are relevant and interesting to the individual user and thus more valuable for publishers and third-party advertisers.\",\"cookiesTextUnclassified\":\"We are in the process of classifying unclassified cookies together with the providers of the individual cookies.\"}},\"dictionary\":{\"metadata\":{\"tags\":[],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"28p2JqzwPvXsM3MBaWcpVI\",\"type\":\"Entry\",\"createdAt\":\"2023-12-06T22:07:14.426Z\",\"updatedAt\":\"2024-05-14T22:20:14.825Z\",\"environment\":{\"sys\":{\"id\":\"master\",\"type\":\"Link\",\"linkType\":\"Environment\"}},\"publishedVersion\":26,\"revision\":6,\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"dictionary\"}},\"locale\":\"en-US\"},\"fields\":{\"name\":\"Global Dictionary\",\"microcopy\":[{\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"us\"}}],\"concepts\":[]},\"sys\":{\"space\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"Space\",\"id\":\"fk5croonv4b3\"}},\"id\":\"3JeGSszCdalVxaFrsVkW1e\",\"type\":\"Entry\",\"createdAt\":\"2024-02-23T22:55:59.933Z\",\"updatedAt\":\"2024